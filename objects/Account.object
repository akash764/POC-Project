                    <fullName>Real Estate Investor</fullName>
                    <default>false</default>
                    <label>Real Estate Investor</label>
                </value>
                <value>
                    <fullName>Corporate Tenant</fullName>
                    <default>false</default>
                    <label>Corporate Tenant</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
