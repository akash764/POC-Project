    <fields>
        <fullName>Display_Order__c</fullName>
        <defaultValue>1</defaultValue>
        <description>Sequence in which the amenity appears on the website (e.g. 1, 2, 3...).</description>
        <externalId>false</externalId>
        <inlineHelpText>Display order sequence on the project page.</inlineHelpText>
        <label>Display Order</label>
        <precision>2</precision>
        <required>false</required>
