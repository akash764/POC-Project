    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Single source of truth for the property sale agreement, financial ledgers, and handover.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Booking</label>
    <nameField>
        <displayFormat>BK-{YYYY}-{0000}</displayFormat>
        <label>Booking Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Bookings</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Account__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Project__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Property_Unit__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Booking_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Booking_Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Final_Agreed_Price__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Total_Paid_Amount__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Balance_Due__c</customTabListAdditionalFields>
        <searchResultsAdditionalFields>Account__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Project__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Property_Unit__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Booking_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Booking_Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Final_Agreed_Price__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Total_Paid_Amount__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Legal owner / primary buyer.</description>
        <label>Primary Buyer</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Bookings</relationshipLabel>
        <relationshipName>Bookings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Master project reference.</description>
        <label>Project</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Bookings</relationshipLabel>
        <relationshipName>Bookings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Balance_Due__c</fullName>
        <description>Remaining balance due on the booking.</description>
        <formula>Final_Agreed_Price__c - Total_Paid_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Balance Due</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Opportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Closes the sales pipeline.</description>
        <label>Source Deal</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Bookings</relationshipLabel>
        <relationshipName>Bookings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Booking_Date__c</fullName>
        <description>Timestamp/Date of deposit.</description>
        <label>Date of Booking</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Property_Unit__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Specific flat/villa allocated.</description>
        <label>Booked Unit</label>
        <referenceTo>Property_Unit__c</referenceTo>
        <relationshipLabel>Bookings</relationshipLabel>
        <relationshipName>Bookings</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Refund_Amount__c</fullName>
        <description>Net amount to be refunded upon cancellation after deductions.</description>
        <formula>MAX(0, Total_Paid_Amount__c - BLANKVALUE(Deduction_Amount__c, 0))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Net Refund Due</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Refund_Status__c</fullName>
        <description>Refund Status: Not Applicable, Pending Approval, Approved by Finance, Refund Processed, Refund Completed.</description>
        <label>Refund Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Applicable</fullName>
                    <default>true</default>
                    <label>Not Applicable</label>
                </value>
                <value>
                    <fullName>Pending Approval</fullName>
                    <default>false</default>
                    <label>Pending Approval</label>
                </value>
                <value>
                    <fullName>Approved by Finance</fullName>
                    <default>false</default>
                    <label>Approved by Finance</label>
                </value>
                <value>
                    <fullName>Refund Processed</fullName>
                    <default>false</default>
                    <label>Refund Processed</label>
                </value>
                <value>
                    <fullName>Refund Completed</fullName>
                    <default>false</default>
                    <label>Refund Completed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Booking_Status__c</fullName>
        <description>Lifecycle status of booking: Token Received, Sale Agreement Executed, Under Handover, Completed, Cancellation In-Progress, Cancelled.</description>
        <label>Booking Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Waiting Token Payement</fullName>
                    <default>true</default>
                    <label>Waiting Token Payement</label>
                </value>
                <value>
                    <fullName>Token Received</fullName>
                    <default>false</default>
                    <label>Token Received</label>
                </value>
                <value>
                    <fullName>Sale Agreement Executed</fullName>
                    <default>false</default>
                    <label>Sale Agreement Executed</label>
                </value>
                <value>
                    <fullName>Under Handover</fullName>
                    <default>false</default>
                    <label>Under Handover</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed / Closed</label>
                </value>
                <value>
                    <fullName>Cancellation In-Progress</fullName>
                    <default>false</default>
                    <label>Cancellation In-Progress</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled / Closed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Deduction_Amount__c</fullName>
        <description>Administrative cancellation charges deducted by developer (e.g. ₹50,000).</description>
        <label>Deduction Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Cancellation_Date__c</fullName>
        <description>Timestamp when cancellation was requested.</description>
        <label>Cancellation Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Total_Paid_Amount__c</fullName>
        <description>Native SUM of child Payment__c.Amount__c where Status__c = &apos;Success&apos;.</description>
        <label>Total Paid Amount</label>
        <summarizedField>Payment__c.Amount__c</summarizedField>
        <summaryFilterItems>
            <field>Payment__c.Status__c</field>
            <operation>equals</operation>
            <value>Success</value>
        </summaryFilterItems>
        <summaryForeignKey>Payment__c.Booking__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Final_Agreed_Price__c</fullName>
        <description>Contract value after agreed quote.</description>
        <label>Final Sale Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Refund_Payment_Ref__c</fullName>
        <description>Razorpay Refund ID (rfnd_xxx) or NEFT UTR number.</description>
        <externalId>false</externalId>
        <label>Refund Reference ID</label>
        <length>100</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Cancellation_Reason__c</fullName>
        <description>Cancellation Reason: Home Loan Rejected, Personal Financial Constraints, Relocation / Transfer, Change of Mind, Disputed Agreement Terms.</description>
        <label>Cancellation Reason</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Home Loan Rejected</fullName>
                    <default>false</default>
                    <label>Home Loan Rejected</label>
                </value>
                <value>
                    <fullName>Personal Financial Constraints</fullName>
                    <default>false</default>
                    <label>Personal Financial Constraints</label>
                </value>
                <value>
                    <fullName>Relocation / Transfer</fullName>
                    <default>false</default>
                    <label>Relocation / Transfer</label>
                </value>
                <value>
                    <fullName>Change of Mind</fullName>
                    <default>false</default>
                    <label>Change of Mind</label>
                </value>
                <value>
                    <fullName>Disputed Agreement Terms</fullName>
                    <default>false</default>
                    <label>Disputed Agreement Terms</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>