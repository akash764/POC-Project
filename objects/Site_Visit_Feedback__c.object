    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores qualitative site walkthrough survey reports, customer interest scoring, budget suitability, and buyer objections.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Site Visit Feedback</label>
    <nameField>
        <displayFormat>SVF-{00000}</displayFormat>
        <label>Feedback Ref</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Site Visit Feedbacks</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Lead__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Project_Visited__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Visit_Date__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Overall_Rating__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Budget_Suitability__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Sales_Executive__c</customTabListAdditionalFields>
        <searchResultsAdditionalFields>Lead__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Project_Visited__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Visit_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Overall_Rating__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Budget_Suitability__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Preferred_BHK_or_Unit__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Next_Follow_Up_Date__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Sales_Executive__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Lead__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Prospective buyer who attended the site walkthrough.</description>
        <label>Inquired Buyer (Lead)</label>
        <referenceTo>Lead</referenceTo>
        <relationshipLabel>Site Visit Feedbacks</relationshipLabel>
        <relationshipName>Site_Visit_Feedbacks</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Visit_Date__c</fullName>
        <defaultValue>Today()</defaultValue>
        <description>Actual date on which the customer conducted the physical walk-through.</description>
        <label>Actual Walkthrough Date</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Overall_Rating__c</fullName>
        <description>Overall buyer intent rating concluded following the walkthrough.</description>
        <label>Overall Buyer Intent</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Hot (Ready to Book)</fullName>
                    <default>false</default>
                    <label>Hot (Ready to Book)</label>
                </value>
                <value>
                    <fullName>Warm (Comparing Options)</fullName>
                    <default>true</default>
                    <label>Warm (Comparing Options)</label>
                </value>
                <value>
                    <fullName>Cold (Low Intent / Budget Issue)</fullName>
                    <default>false</default>
                    <label>Cold (Low Intent / Budget Issue)</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Project_Visited__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Development site inspected during the walkthrough.</description>
        <label>Development Visited</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Site Visit Feedbacks</relationshipLabel>
        <relationshipName>Site_Visit_Feedbacks</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sales_Executive__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Sales executive who conducted the property tour.</description>
        <label>Sales Executive</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Site_Visit_Feedbacks</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Detailed_Remarks__c</fullName>
        <description>Comprehensive inspection feedback, preferred view/floor, objections, and next steps.</description>
        <label>Detailed Observations &amp; Remarks</label>
        <length>1500</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Budget_Suitability__c</fullName>
        <description>Customer budget qualification against unit pricing.</description>
        <label>Budget Suitability</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Within Budget</fullName>
                    <default>true</default>
                    <label>Within Budget</label>
                </value>
                <value>
                    <fullName>Slightly High (5-10%)</fullName>
                    <default>false</default>
                    <label>Slightly High (5-10%)</label>
                </value>
                <value>
                    <fullName>Significantly Over Budget</fullName>
                    <default>false</default>
                    <label>Significantly Over Budget</label>
                </value>
                <value>
                    <fullName>Flexible for Ideal Unit</fullName>
                    <default>false</default>
                    <label>Flexible for Ideal Unit</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Pricing_Perception__c</fullName>
        <description>Buyer reaction to quote / project rate card.</description>
        <label>Pricing Perception</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Attractive / High Value</fullName>
                    <default>false</default>
                    <label>Attractive / High Value</label>
                </value>
                <value>
                    <fullName>Fair / Market Rate</fullName>
                    <default>true</default>
                    <label>Fair / Market Rate</label>
                </value>
                <value>
                    <fullName>Overpriced / Negotiation Required</fullName>
                    <default>false</default>
                    <label>Overpriced / Negotiation Required</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Next_Follow_Up_Date__c</fullName>
        <description>Target date for next sales action (cost sheet dispatch, unit shortlist, or second visit).</description>
        <label>Next Follow-Up Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Site_Visit_Event_Id__c</fullName>
        <description>Salesforce 18-digit Record ID of the parent Event appointment.</description>
        <externalId>false</externalId>
        <label>Appointment Event ID</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Accompanying_Visitors__c</fullName>
        <description>Parties accompanying the prospective buyer during the physical tour.</description>
        <label>Accompanying Party</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Self Only</fullName>
                    <default>false</default>
                    <label>Self Only</label>
                </value>
                <value>
                    <fullName>With Spouse</fullName>
                    <default>false</default>
                    <label>With Spouse</label>
                </value>
                <value>
                    <fullName>With Entire Family / Parents</fullName>
                    <default>true</default>
                    <label>With Entire Family / Parents</label>
                </value>
                <value>
                    <fullName>With Channel Partner / Broker</fullName>
                    <default>false</default>
                    <label>With Channel Partner / Broker</label>
                </value>
                <value>
                    <fullName>With Architect / Interior Designer</fullName>
                    <default>false</default>
                    <label>With Architect / Interior Designer</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Preferred_BHK_or_Unit__c</fullName>
        <description>Unit configuration preferred by the prospect during the site visit.</description>
        <label>Preferred Configuration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1 BHK</fullName>
                    <default>false</default>
                    <label>1 BHK</label>
                </value>
                <value>
                    <fullName>2 BHK</fullName>
                    <default>false</default>
                    <label>2 BHK</label>
                </value>
                <value>
                    <fullName>3 BHK</fullName>
                    <default>true</default>
                    <label>3 BHK</label>
                </value>
                <value>
                    <fullName>4 BHK</fullName>
                    <default>false</default>
                    <label>4 BHK</label>
                </value>
                <value>
                    <fullName>5+ BHK / Penthouse</fullName>
                    <default>false</default>
                    <label>5+ BHK / Penthouse</label>
                </value>
                <value>
                    <fullName>Luxury Villa</fullName>
                    <default>false</default>
                    <label>Luxury Villa</label>
                </value>
                <value>
                    <fullName>Commercial Office</fullName>
                    <default>false</default>
                    <label>Commercial Office</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>