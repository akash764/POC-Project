    <sharingModel>ControlledByParent</sharingModel>
    <fields>
        <fullName>Role__c</fullName>
        <description>Identifies the contact&apos;s legal or operational role in property purchase agreements or chauffeur services.</description>
        <label>Contact Role</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Primary Applicant</fullName>
                    <default>true</default>
                    <label>Primary Applicant</label>
                </value>
                <value>
                    <fullName>Co-Applicant</fullName>
                    <default>false</default>
                    <label>Co-Applicant</label>
                </value>
                <value>
                    <fullName>Authorized Signatory</fullName>
                    <default>false</default>
                    <label>Authorized Signatory</label>
                </value>
                <value>
                    <fullName>Billing / Accounts Contact</fullName>
                    <default>false</default>
                    <label>Billing / Accounts Contact</label>
                </value>
                <value>
                    <fullName>Chauffeur / Driver</fullName>
                    <default>false</default>
                    <label>Chauffeur / Driver</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Is_Driver__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Flag indicating if this contact is an authorized chauffeur / driver in the UrbanNest fleet.</description>
        <label>Is Driver?</label>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PAN_Number__c</fullName>
        <description>Personal Income Tax Permanent Account Number (PAN) for sale deeds and loan documents.</description>
        <externalId>false</externalId>
        <label>PAN Number</label>
        <length>10</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Available__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Flag indicating if this contact is an authorized chauffeur / driver in the UrbanNest fleet.</description>
        <label>Is Available?</label>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Aadhar_Number__c</fullName>
        <description>12-digit Government of India Aadhaar identity number for RERA registration.</description>
        <externalId>false</externalId>
        <label>Aadhaar Number</label>
        <length>12</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <webLinks>
        <fullName>GoogleMaps</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Google Maps</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>http://maps.google.com/maps?f=q&amp;hl=en&amp;q={!Contact_MailingStreet}+{!Contact_MailingCity}+{!Contact_MailingState}&amp;om=1</url>
    </webLinks>
    <webLinks>
        <fullName>GoogleSearch</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Google Search</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>http://www.google.com/search?q={!Contact_FirstName} {!Contact_LastName}</url>
    </webLinks>
</CustomObject>