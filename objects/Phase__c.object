    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents a development phase, residential tower, villa enclave, or commercial wing within a Project.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <label>Phase</label>
    <nameField>
        <label>Phase Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Phases</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Project__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Phase_Type__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Total_Floors__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Available_Units__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Number_of_Units__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Construction_Status__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Address__c</fullName>
        <description>Physical location or wing address within the project.</description>
        <externalId>false</externalId>
        <label>Address</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <description>Parent Project development.</description>
        <label>Project</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Phases</relationshipLabel>
        <relationshipName>Phases</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Phase_Type__c</fullName>
        <description>Type of sub-division (Tower/Block for Apartments, Enclave for Villas, Wing for Commercial).</description>
        <label>Phase Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Tower / Block</fullName>
                    <default>true</default>
                    <label>Tower / Block</label>
                </value>
                <value>
                    <fullName>Villa Enclave</fullName>
                    <default>false</default>
                    <label>Villa Enclave</label>
                </value>
                <value>
                    <fullName>Commercial Wing</fullName>
                    <default>false</default>
                    <label>Commercial Wing</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Total_Floors__c</fullName>
        <description>Total floors or levels in this phase (e.g., 14 for tower, 2 for villa duplex).</description>
        <externalId>false</externalId>
        <label>Total Floors</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Available_Units__c</fullName>
        <description>Auto-calculated roll-up summary count of child Property Units with Status = Available.</description>
        <label>Available Units</label>
        <summaryFilterItems>
            <field>Property_Unit__c.Status__c</field>
            <operation>equals</operation>
            <value>Available</value>
        </summaryFilterItems>
        <summaryForeignKey>Property_Unit__c.Phase__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Number_of_Units__c</fullName>
        <description>Auto-calculated roll-up summary count of all child Property Units in this Phase.</description>
        <label>Number of Units</label>
        <summaryForeignKey>Property_Unit__c.Phase__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Photo_Content_Key__c</fullName>
        <description>CMS Content Key or Image URL for phase architectural elevation.</description>
        <externalId>false</externalId>
        <label>Photo Content Key</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Construction_Status__c</fullName>
        <description>Current execution progress of this phase.</description>
        <label>Construction Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Under Construction</fullName>
                    <default>true</default>
                    <label>Under Construction</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Not Started</fullName>
                    <default>false</default>
                    <label>Not Started</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Phase_Type_Mismatched__c</fullName>
        <formula>NOT(
    OR(
        AND(
            ISPICKVAL(Project__r.Project_Type__c, &quot;Apartment&quot;),
            ISPICKVAL(Phase_Type__c, &quot;Tower or Block&quot;)
        ),
        AND(
            ISPICKVAL(Project__r.Project_Type__c, &quot;Villa&quot;),
            ISPICKVAL(Phase_Type__c, &quot;Villa Enclave&quot;)
        ),
        AND(
            ISPICKVAL(Project__r.Project_Type__c, &quot;Commercial&quot;),
            ISPICKVAL(Phase_Type__c, &quot;Commercial Wing&quot;)
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Phase Type Mismatched</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <validationRules>
        <fullName>Restrict_The_Wrong_Phase_Type</fullName>
        <active>true</active>
        <description>Restricts the user from selecting the wrong phase type based on project classification.</description>
        <errorConditionFormula>AND(
  ISNEW(),
  NOT(
    OR(
      AND(
        OR(ISPICKVAL(Project__r.Project_Type__c, &quot;Residential_Apartment&quot;), ISPICKVAL(Project__r.Project_Type__c, &quot;Apartment&quot;)),
        OR(ISPICKVAL(Phase_Type__c, &quot;Tower or Block&quot;), ISPICKVAL(Phase_Type__c, &quot;Tower / Block&quot;))
      ),
      AND(
        OR(ISPICKVAL(Project__r.Project_Type__c, &quot;Residential_Villa&quot;), ISPICKVAL(Project__r.Project_Type__c, &quot;Villa&quot;)),
        ISPICKVAL(Phase_Type__c, &quot;Villa Enclave&quot;)
      ),
      AND(
        ISPICKVAL(Project__r.Project_Type__c, &quot;Commercial&quot;),
        ISPICKVAL(Phase_Type__c, &quot;Commercial Wing&quot;)
      )
    )
  )
)</errorConditionFormula>
        <errorDisplayField>Phase_Type__c</errorDisplayField>
        <errorMessage>Invalid Phase Type for the selected Project Type. Please select a valid Phase Type</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Total_Floor_Reduction_Validation_Rule</fullName>
        <active>true</active>
        <description>This validation rule block the decreasing of the floor number</description>
        <errorConditionFormula>ISCHANGED(Total_Floors__c) &amp;&amp; (Total_Floors__c &lt;  PRIORVALUE( Total_Floors__c ))</errorConditionFormula>
        <errorDisplayField>Total_Floors__c</errorDisplayField>
        <errorMessage>Floor Number Should not less than</errorMessage>
    </validationRules>
</CustomObject>