    <compactLayoutAssignment>Leads_Custom_Compact_Layout</compactLayoutAssignment>
    <enableFeeds>true</enableFeeds>
    <enableHistory>false</enableHistory>
    <externalSharingModel>Private</externalSharingModel>
    <searchLayouts>
        <customTabListAdditionalFields>FULL_NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>LEAD.COMPANY</customTabListAdditionalFields>
        <customTabListAdditionalFields>LEAD.PHONE</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>FULL_NAME</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>LEAD.COMPANY</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>FULL_NAME</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>LEAD.COMPANY</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>LEAD.PHONE</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>LEAD.MOBILE_PHONE</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>LEAD.FAX</lookupPhoneDialogsAdditionalFields>
        <searchResultsAdditionalFields>FULL_NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LEAD.STATUS</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LEAD.PHONE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LEAD.EMAIL</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Preferred_Project__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>BHK_Preference__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Location_Preference__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CORE.USERS.ALIAS</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWriteTransfer</sharingModel>
    <compactLayouts>
        <fullName>Leads_Custom_Compact_Layout</fullName>
        <fields>Name</fields>
        <fields>Company</fields>
        <fields>Title</fields>
        <fields>Phone</fields>
        <fields>MobilePhone</fields>
        <fields>Email</fields>
        <label>Leads Custom Compact Layout</label>
    </compactLayouts>
    <fields>
        <fullName>Budget__c</fullName>
        <description>Maximum purchase budget indicated by the prospect.</description>
        <label>Budget</label>
        <precision>16</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Demo_field__c</fullName>
        <externalId>false</externalId>
        <label>Demo field</label>
        <length>30</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>BHK_Preference__c</fullName>
        <description>Preferred configuration requested by the prospect (e.g. 1 BHK, 2 BHK, Villa, Commercial Space / Office, Penthouse).</description>
        <externalId>false</externalId>
        <label>BHK Preference</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Submission_Key__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Client-generated UUID idempotency key ensuring replay protection on duplicate network clicks.</description>
        <externalId>true</externalId>
        <label>Submission Key</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>WhatsApp_Opt_In__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether the prospect opted into receiving project updates via WhatsApp.</description>
        <label>WhatsApp Opt-In</label>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Normalized_Email__c</fullName>
        <description>System maintained lowercase trimmed email address for duplicate matching.</description>
        <externalId>false</externalId>
        <label>Normalized Email</label>
        <length>254</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Normalized_Phone__c</fullName>
        <description>System maintained digits-only telephone number used for idempotent duplicate detection.</description>
        <externalId>false</externalId>
        <label>Normalized Phone</label>
        <length>30</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Preferred_Project__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The specific UrbanNest project the visitor enquired about.</description>
        <label>Preferred Project</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Enquiring Leads</relationshipLabel>
        <relationshipName>Leads</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Location_Preference__c</fullName>
        <description>Preferred residential neighborhood, micro-market, or city indicated by the buyer (e.g., Anna Nagar, OMR, Whitefield).</description>
        <externalId>false</externalId>
        <label>Location Preference</label>
        <length>100</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Next_follow_up_Date__c</fullName>
        <label>Next follow up Date</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Total_Vehicle_Booking__c</fullName>
        <defaultValue>0</defaultValue>
        <externalId>false</externalId>
        <label>Total Vehicle Booking</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <validationRules>
        <fullName>Lead_Budget_Nonnegative</fullName>
        <active>true</active>
        <description>Lead budget must be greater than or equal to zero.</description>
        <errorConditionFormula>Budget__c &lt; 0</errorConditionFormula>
        <errorDisplayField>Budget__c</errorDisplayField>
        <errorMessage>Budget cannot be negative</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Direct_Conversion_Status</fullName>
        <active>true</active>
        <description>Prevents users from manually changing the Lead status to Qualified / Converted from the Path or record detail without clicking the Convert Lead button.</description>
        <errorConditionFormula>AND(
    ISCHANGED(Status),
    ISPICKVAL(Status, &apos;Qualified&apos;),
    NOT(IsConverted)
)</errorConditionFormula>
        <errorDisplayField>Status</errorDisplayField>
        <errorMessage>Leads cannot be marked as Qualified directly from the Path. Please click the &apos;Convert Lead&apos; button in the header action bar to convert this lead.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Tell_User_to_Click_Conver_Lead_Button</fullName>
        <active>false</active>
        <description>This Rule will user to Press Convert Lead Button On top right side Cornor</description>
        <errorConditionFormula>AND(
    ISCHANGED(  Status ),
    ISPICKVAL(Status, &apos;Qualified&apos;),
    NOT(IsConverted)
)</errorConditionFormula>
        <errorMessage>Please click the &apos;Convert Lead&apos; button in the header action bar to convert this lead</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>GoogleMaps</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Google Maps</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>http://maps.google.com/maps?f=q&amp;hl=en&amp;q={!Lead_Street}+{!Lead_City}+{!Lead_State}&amp;om=1</url>
    </webLinks>
    <webLinks>
        <fullName>GoogleNews</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Google News</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>http://www.google.com/news?&amp;q={!Lead_Company}&amp;btnG=Search+News</url>
    </webLinks>
    <webLinks>
        <fullName>GoogleSearch</fullName>
        <availability>online</availability>
        <displayType>link</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Google Search</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>http://www.google.com/search?q={!Lead_Company}</url>
    </webLinks>
</CustomObject>