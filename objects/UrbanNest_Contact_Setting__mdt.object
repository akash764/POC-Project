<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Stores global business contact information (address, phone, email, visitor hours) for UrbanNest digital experiences.</description>
    <label>UrbanNest Contact Setting</label>
    <pluralLabel>UrbanNest Contact Settings</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Email__c</fullName>
        <description>Official business enquiry email address.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Email</label>
        <length>80</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Address__c</fullName>
        <description>Corporate office physical address displayed on website and collateral.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Address</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phone_Number__c</fullName>
        <description>Business direct phone number displayed on website and communication.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Phone Number</label>
        <length>40</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Visitor_Hours__c</fullName>
        <description>Office / Experience center visiting hours.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Visitor Hours</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>