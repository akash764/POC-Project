    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>InDevelopment</deploymentStatus>
    <description>Represents an individual residential flat or unit within an UrbanNest apartment block.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <label>House Unit</label>
    <nameField>
        <label>Unit Number</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>House Units</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>BHK__c</fullName>
        <description>Bedroom, Hall, Kitchen configuration.</description>
        <label>BHK</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1 BHK</fullName>
                    <default>false</default>
                    <label>1 BHK</label>
                </value>
                <value>
                    <fullName>2 BHK</fullName>
                    <default>true</default>
                    <label>2 BHK</label>
                </value>
                <value>
                    <fullName>3 BHK</fullName>
                    <default>false</default>
                    <label>3 BHK</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Area__c</fullName>
        <description>Super built-up area of the unit in square feet.</description>
        <externalId>false</externalId>
        <label>Area (sq.ft.)</label>
        <precision>8</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Floor__c</fullName>
        <description>Floor number on which the unit is located (0 for Ground Floor).</description>
        <externalId>false</externalId>
        <label>Floor</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Price__c</fullName>
        <description>Total base offering price in INR for this residential unit.</description>
        <label>Price</label>
        <precision>16</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Facing__c</fullName>
        <description>Directional orientation/facing of the main entrance according to Vaastu principles.</description>
        <label>Facing</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>North</fullName>
                    <default>false</default>
                    <label>North</label>
                </value>
                <value>
                    <fullName>South</fullName>
                    <default>false</default>
                    <label>South</label>
                </value>
                <value>
                    <fullName>East</fullName>
                    <default>true</default>
                    <label>East</label>
                </value>
                <value>
                    <fullName>West</fullName>
                    <default>false</default>
                    <label>West</label>
                </value>
                <value>
                    <fullName>North-East</fullName>
                    <default>false</default>
                    <label>North-East</label>
                </value>
                <value>
                    <fullName>North-West</fullName>
                    <default>false</default>
                    <label>North-West</label>
                </value>
                <value>
                    <fullName>South-East</fullName>
                    <default>false</default>
                    <label>South-East</label>
                </value>
                <value>
                    <fullName>South-West</fullName>
                    <default>false</default>
                    <label>South-West</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Current inventory lifecycle status of this residential unit.</description>
        <label>Status</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Available</fullName>
                    <default>true</default>
                    <label>Available</label>
                </value>
                <value>
                    <fullName>Under Offer</fullName>
                    <default>false</default>
                    <label>Under Offer</label>
                </value>
                <value>
                    <fullName>Reserved</fullName>
                    <default>false</default>
                    <label>Reserved</label>
                </value>
                <value>
                    <fullName>Sold</fullName>
                    <default>false</default>
                    <label>Sold</label>
                </value>
                <value>
                    <fullName>Occupied</fullName>
                    <default>false</default>
                    <label>Occupied</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Apartment__c</fullName>
        <description>Parent apartment block containing this residential unit.</description>
        <label>Apartment</label>
        <referenceTo>Apartment__c</referenceTo>
        <relationshipLabel>House Units</relationshipLabel>
        <relationshipName>House_Units</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Bathrooms__c</fullName>
        <description>Number of bathrooms/restrooms in the unit.</description>
        <externalId>false</externalId>
        <label>Bathrooms</label>
        <precision>2</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Current_Booking__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>System maintained reference to the active booking Opportunity holding this unit. Restricted from public access.</description>
        <label>Current Booking</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Booked House Units</relationshipLabel>
        <relationshipName>House_Units</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Possession_Date__c</fullName>
        <description>Estimated or confirmed key handover and possession date.</description>
        <label>Possession Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Parking_Available__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates whether dedicated vehicle parking is bundled with this unit.</description>
        <label>Parking Available</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Sample_Photo_Content_Key__c</fullName>
        <description>Salesforce CMS Managed Content Key referencing the sample flat photograph or floor plan.</description>
        <externalId>false</externalId>
        <label>Sample Photo Content Key</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <validationRules>
        <fullName>Validate_Area</fullName>
        <active>true</active>
        <errorConditionFormula>Area__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>Area__c</errorDisplayField>
        <errorMessage>Area must be greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Floor</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
    Floor__c &lt; 0,
    Floor__c &gt; Apartment__r.Total_Floors__c
)</errorConditionFormula>
        <errorDisplayField>Floor__c</errorDisplayField>
        <errorMessage>Floor must be between 0 and the block floor count</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Price</fullName>
        <active>true</active>
        <errorConditionFormula>Price__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>Price__c</errorDisplayField>
        <errorMessage>Price must be greater than zero.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Positive_Values</fullName>
        <active>true</active>
        <description>Area, price, and bathrooms count must be positive numbers.</description>
        <errorConditionFormula>Area__c &lt;= 0 || Price__c &lt;= 0 || Bathrooms__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>Price__c</errorDisplayField>
        <errorMessage>Area, price, and bathrooms must be positive numbers</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validate_Bathrooms</fullName>
        <active>true</active>
        <errorConditionFormula>Bathrooms__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>Bathrooms__c</errorDisplayField>
        <errorMessage>Bathrooms must be greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Floor_Within_Bounds</fullName>
        <active>true</active>
        <description>Floor number must be between 0 (Ground) and the parent apartment block total floor count.</description>
        <errorConditionFormula>Floor__c &lt; 0 || Floor__c &gt; Apartment__r.Total_Floors__c</errorConditionFormula>
        <errorDisplayField>Floor__c</errorDisplayField>
        <errorMessage>Floor must be between 0 and the block floor count</errorMessage>
    </validationRules>
</CustomObject>