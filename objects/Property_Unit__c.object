                    <default>true</default>
                    <label>2 BHK Luxury Flat</label>
                </value>
                <value>
                    <fullName>3 BHK Premium Flat</fullName>
                    <default>false</default>
                    <label>3 BHK Premium Flat</label>
                </value>
                <value>
                    <fullName>4 BHK Sky Penthouse</fullName>
                    <default>false</default>
                    <label>4 BHK Sky Penthouse</label>
                </value>
                <value>
                    <fullName>3 BHK Luxury Villa</fullName>
                    <default>false</default>
                    <label>3 BHK Luxury Villa</label>
                </value>
                <value>
                    <fullName>4 BHK Presidential Villa</fullName>
                    <default>false</default>
                    <label>4 BHK Presidential Villa</label>
                </value>
                <value>
                    <fullName>Duplex Villa</fullName>
                    <default>false</default>
                    <label>Duplex Villa</label>
                </value>
                <value>
                    <fullName>Grade-A Office Suite</fullName>
                    <default>false</default>
                    <label>Grade-A Office Suite</label>
                </value>
                <value>
                    <fullName>Retail Showroom</fullName>
                    <default>false</default>
                    <label>Retail Showroom</label>
                </value>
                <value>
                    <fullName>Anchor Store</fullName>
                    <default>false</default>
                    <label>Anchor Store</label>
                </value>
                <value>
                    <fullName>Food Court Bay</fullName>
                    <default>false</default>
                    <label>Food Court Bay</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Carpet_Area__c</fullName>
        <description>Usable RERA carpet area in square feet.</description>
        <externalId>false</externalId>
        <label>Carpet Area (Sq.Ft)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Billable_Area__c</fullName>
        <description>Effective saleable / billable area in square feet depending on record type (Super Built-Up Area for Apartment/Commercial, Plot Area/Carpet Area for Villa).</description>
        <externalId>false</externalId>
        <formula>IF(RecordType.DeveloperName = &apos;Villa_Unit&apos;, 
   BLANKVALUE(Plot_Area__c, BLANKVALUE(Carpet_Area__c, 0)), 
   BLANKVALUE(Super_Built_Up_Area__c, BLANKVALUE(Carpet_Area__c, 0))
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Effective pricing area: Super Built-Up for Apartment/Commercial; Plot/Carpet for Villa.</inlineHelpText>
        <label>Billable Area (Sq.Ft)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Current_Booking__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lead enquiry that holds the current reservation or blocking.</description>
        <label>Current Booking</label>
        <referenceTo>Lead</referenceTo>
        <relationshipLabel>Booked Units</relationshipLabel>
        <relationshipName>Booked_Units</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Possession_Date__c</fullName>
        <description>Target date for key handover.</description>
        <label>Possession Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Amenities_Charge__c</fullName>
        <description>One-time amenities and infrastructure development fee inherited from parent project.</description>
        <formula>BLANKVALUE(Phase__r.Project__r.Amenities_Infrastructure_Charge__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Inherited from Project Amenities &amp; Infrastructure Charge.</inlineHelpText>
        <label>Amenities &amp; Infrastructure Charge</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Furnishing_Status__c</fullName>
        <description>Furnishing handover state (especially important for commercial and high-end villas).</description>
        <label>Furnishing Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Unfurnished</fullName>
                    <default>true</default>
                    <label>Unfurnished</label>
                </value>
                <value>
                    <fullName>Semi-Furnished</fullName>
                    <default>false</default>
                    <label>Semi-Furnished</label>
                </value>
                <value>
                    <fullName>Fully Furnished</fullName>
                    <default>false</default>
                    <label>Fully Furnished</label>
                </value>
                <value>
                    <fullName>Bare Shell</fullName>
                    <default>false</default>
                    <label>Bare Shell</label>
                </value>
                <value>
                    <fullName>Warm Shell</fullName>
                    <default>false</default>
                    <label>Warm Shell</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Parking_Available__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates whether dedicated covered parking or EV slot is allotted.</description>
        <label>Parking Available</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Base_Rate_Per_SqFt__c</fullName>
        <description>Base selling rate per square foot for this property unit.</description>
        <inlineHelpText>Enter the base price per sq.ft (e.g. ₹5,500). System will auto-calculate Base Price based on unit area.</inlineHelpText>
        <label>Base Rate Per Sq.Ft</label>
        <precision>16</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Property_Identifier__c</fullName>
        <description>This fields is created for back end Purpose. To reprensent Icon on the Units Fields.. This is field Not be in in the UI</description>
        <externalId>false</externalId>
        <formula>TEXT(Phase__r.Project__r.Project_Type__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Property Identifier</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Super_Built_Up_Area__c</fullName>
        <description>Total super built-up area including loading and common spaces in square feet.</description>
        <externalId>false</externalId>
        <label>Super Built-Up Area (Sq.Ft)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sample_Photo_Content_Key__c</fullName>
        <description>CMS Content Key or Image URL for interior sample flat/villa/office photography.</description>
        <externalId>false</externalId>
        <label>Sample Photo Content Key</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Total_All_Inclusive_Price__c</fullName>
        <description>All-inclusive purchase cost comprising base unit price, amenities/infrastructure fee, and advance maintenance.</description>
        <formula>BLANKVALUE(Price__c, 0) + Amenities_Charge__c + Advance_Maintenance_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Base Unit Price + Amenities Charge + Advance Maintenance Amount.</inlineHelpText>
        <label>Total All-Inclusive Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Advance_Maintenance_Amount__c</fullName>
        <description>Total advance maintenance (CAM) calculated for the advance period based on unit area and project monthly rate.</description>
        <formula>BLANKVALUE(Super_Built_Up_Area__c, BLANKVALUE(Carpet_Area__c, 0)) * BLANKVALUE(Phase__r.Project__r.Maintenance_Rate_Per_SqFt__c, 0) * (BLANKVALUE(Phase__r.Project__r.Advance_Maintenance_Years__c, 3) * 12)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Auto-calculated: Area (sq.ft) × Monthly Rate × (Advance Years × 12 months).</inlineHelpText>
        <label>Advance Maintenance Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <recordTypes>
        <fullName>Villa_Unit</fullName>
        <active>true</active>
        <description>Luxury independent villa, duplex, or row house with dedicated plot and private garden.</description>
        <label>Villa Unit</label>
        <picklistValues>
            <picklist>BHK__c</picklist>
            <values>
                <fullName>3 BHK</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>4 BHK</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>5 BHK</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Facing__c</picklist>
            <values>
                <fullName>East</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>North</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>North-East</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>South</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>West</fullName>
                <default>false</default>
