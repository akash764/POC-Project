    <validationRules>
        <fullName>Price_Positive</fullName>
        <active>true</active>
        <description>Price must be greater than zero</description>
        <errorConditionFormula>Price__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>Price__c</errorDisplayField>
        <errorMessage>Price must be greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Positive_Values</fullName>
        <active>true</active>
        <description>Unit price and carpet area must be positive non-zero numbers.</description>
        <errorConditionFormula>Price__c &lt;= 0 || Carpet_Area__c &lt;= 0</errorConditionFormula>
        <errorMessage>Price and Carpet Area must be positive values.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Rule_Floor_Bounds</fullName>
        <active>false</active>
        <description>Ensures the Floor is between 0 and the parent Phase&apos;s Total Floors for Apartment Flats and Commercial Spaces</description>
        <errorConditionFormula>AND(
    OR(
        RecordType.DeveloperName = &quot;Apartment_Flat&quot;,
        RecordType.DeveloperName = &quot;Commercial_Space&quot;
    ),
    OR(
        ISBLANK(Floor__c),
        Floor__c &lt; 0,
        ISBLANK(Phase__r.Total_Floors__c),
        Floor__c &gt; Phase__r.Total_Floors__c
    )
)</errorConditionFormula>
        <errorDisplayField>Floor__c</errorDisplayField>
        <errorMessage>Floor must be between 0 and the Phase&apos;s Total Floors.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Bathrooms_Positive</fullName>
        <active>true</active>
        <description>Checks that the Bathrooms value is greater than zero when entered for residential properties. Commercial spaces are excluded</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName &lt;&gt; &quot;Commercial_Space&quot;,
    NOT(ISBLANK(Bathrooms__c)),
    Bathrooms__c &lt;= 0
)</errorConditionFormula>
        <errorDisplayField>Bathrooms__c</errorDisplayField>
        <errorMessage>Bathroom count must be greater than zero for residential property units</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Plot_Area_Positive</fullName>
        <active>true</active>
        <description>Checks that Plot Area is greater than zero when entered</description>
        <errorConditionFormula>AND(
    NOT(ISBLANK(Plot_Area__c)),
    Plot_Area__c &lt;= 0
)</errorConditionFormula>
        <errorDisplayField>Plot_Area__c</errorDisplayField>
        <errorMessage>Plot Area must be greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Carpet_Area_Positive</fullName>
        <active>true</active>
        <description>Ensures Carpet Area is greater than zero</description>
        <errorConditionFormula>Carpet_Area__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>Carpet_Area__c</errorDisplayField>
        <errorMessage>Carpet Area must be greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Super_Built_Up_Area_Positive</fullName>
        <active>true</active>
        <description>Checks that Super Built-Up Area is greater than zero when entered</description>
        <errorConditionFormula>AND(
    NOT(ISBLANK(Super_Built_Up_Area__c)),
    Super_Built_Up_Area__c &lt;= 0
)</errorConditionFormula>
        <errorDisplayField>Super_Built_Up_Area__c</errorDisplayField>
        <errorMessage>Super Built-Up Area must be greater than zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Wrong_Unit_Record_Type</fullName>
        <active>true</active>
        <description>Prevents users from selecting a Unit Record Type that does not match the parent Phase Type</description>
        <errorConditionFormula>NOT(
    OR(
        AND(
            OR(
                ISPICKVAL(Phase__r.Phase_Type__c, &quot;Tower or Block&quot;),
                ISPICKVAL(Phase__r.Phase_Type__c, &quot;Tower / Block&quot;)
            ),
            RecordType.DeveloperName = &quot;Apartment_Flat&quot;
        ),
        AND(
            ISPICKVAL(Phase__r.Phase_Type__c, &quot;Villa Enclave&quot;),
            RecordType.DeveloperName = &quot;Villa_Unit&quot;
        ),
        AND(
            ISPICKVAL(Phase__r.Phase_Type__c, &quot;Commercial Wing&quot;),
            RecordType.DeveloperName = &quot;Commercial_Space&quot;
        )
    )
)</errorConditionFormula>
        <errorMessage>This Unit Record Type is not allowed for the selected Phase Type. Please select the correct Unit Record Type</errorMessage>
    </validationRules>
</CustomObject>