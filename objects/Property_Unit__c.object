                    <label>South-West</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Inventory lifecycle state. Supports all 5 standard lifecycle statuses.</description>
        <label>Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Available</fullName>
                    <default>false</default>
                    <label>Available</label>
                </value>
                <value>
                    <fullName>Under Offer</fullName>
                    <default>false</default>
                    <label>Under Offer</label>
                </value>
                <value>
                    <fullName>Reserved</fullName>
                    <default>false</default>
                    <label>Reserved</label>
                </value>
                <value>
                    <fullName>Sold</fullName>
                    <default>false</default>
                    <label>Sold</label>
                </value>
                <value>
                    <fullName>Occupied</fullName>
                    <default>false</default>
                    <label>Occupied</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <description>Reference to the parent Project through Phase.</description>
        <externalId>false</externalId>
        <formula>CASESAFEID(Phase__r.Project__c)</formula>
        <label>Project Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Bathrooms__c</fullName>
        <description>Number of bathrooms/restrooms.</description>
        <externalId>false</externalId>
        <label>Bathrooms</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Plot_Area__c</fullName>
        <description>Total land/plot parcel area in square feet (specifically for Villas and Plotted developments).</description>
        <externalId>false</externalId>
        <label>Plot Area (Sq.Ft)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Unit_Type__c</fullName>
        <description>Specific inventory configuration category across apartments, villas, and commercial spaces.</description>
        <label>Unit Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
