    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents an individual residential flat, luxury villa, or commercial inventory space.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <label>Property Unit</label>
    <nameField>
        <label>Unit Identifier</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Property Units</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <searchLayouts>
        <searchResultsAdditionalFields>Phase__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Unit_Type__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>BHK__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Floor__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Price__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Carpet_Area__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Possession_Date__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>BHK__c</fullName>
        <description>Bedroom configuration (applicable to residential apartments and villas).</description>
        <label>BHK</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1 BHK</fullName>
                    <default>false</default>
                    <label>1 BHK</label>
                </value>
                <value>
                    <fullName>2 BHK</fullName>
                    <default>false</default>
                    <label>2 BHK</label>
                </value>
                <value>
                    <fullName>3 BHK</fullName>
                    <default>false</default>
                    <label>3 BHK</label>
                </value>
                <value>
                    <fullName>4 BHK</fullName>
                    <default>false</default>
                    <label>4 BHK</label>
                </value>
                <value>
                    <fullName>5 BHK</fullName>
                    <default>false</default>
                    <label>5 BHK</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Floor__c</fullName>
        <description>Floor level (e.g. 0 for Ground, 14 for High-rise flat, or G+1 for Villa level).</description>
        <externalId>false</externalId>
        <label>Floor</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Phase__c</fullName>
        <description>Parent Phase, Tower, Enclave, or Wing.</description>
        <label>Phase</label>
        <referenceTo>Phase__c</referenceTo>
        <relationshipLabel>Property Units</relationshipLabel>
        <relationshipName>Property_Units</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Price__c</fullName>
        <description>Total pricing or starting price for this property unit.</description>
        <label>Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
