    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores verified customer site visit reviews and YouTube video testimonials for UrbanNest developments.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <label>Property Review</label>
    <nameField>
        <displayFormat>REV-{00000}</displayFormat>
        <label>Review Ref</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Property Reviews</pluralLabel>
    <recordTypeTrackHistory>false</recordTypeTrackHistory>
    <searchLayouts>
        <customTabListAdditionalFields>Reviewer_Name__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Project__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Rating__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Review_Type__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Video_URL__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Is_Featured_Home__c</customTabListAdditionalFields>
        <searchResultsAdditionalFields>Reviewer_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Project__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Rating__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Review_Type__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Rating__c</fullName>
        <description>Star rating out of 5 (1 to 5).</description>
        <externalId>false</externalId>
        <label>Rating (1-5)</label>
        <precision>1</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Moderation workflow status. Only Approved reviews display publicly on the website.</description>
        <label>Moderation Status</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending Moderation</fullName>
                    <default>true</default>
                    <label>Pending Moderation</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <label>Approved</label>
                </value>
                <value>
                    <fullName>Rejected</fullName>
                    <default>false</default>
                    <label>Rejected</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <description>Parent real estate project being reviewed.</description>
        <label>Project</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Property Reviews</relationshipLabel>
        <relationshipName>Property_Reviews</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Video_URL__c</fullName>
        <description>Direct YouTube video link (e.g., https://www.youtube.com/watch?v=xxx) for video testimonials.</description>
        <label>Video URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>Review_Type__c</fullName>
        <description>Format of the testimonial: written feedback or recorded YouTube video interview.</description>
        <label>Review Type</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Written Review</fullName>
                    <default>true</default>
                    <label>Written Review</label>
                </value>
                <value>
                    <fullName>Video Testimonial</fullName>
                    <default>false</default>
                    <label>Video Testimonial</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Review_Title__c</fullName>
        <description>Short summary title for the review.</description>
        <externalId>false</externalId>
        <label>Review Title</label>
        <length>120</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Reviewer_Name__c</fullName>
        <description>Name of the visitor, buyer, or family submitting the review.</description>
        <externalId>false</externalId>
        <label>Reviewer Name</label>
        <length>100</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Unit_Purchased__c</fullName>
        <description>Configuration or flat number (e.g. 3 BHK Tower Azure, Villa 04, Penthouse), if applicable.</description>
        <externalId>false</externalId>
        <label>Unit or Configuration</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Is_Featured_Home__c</fullName>
        <defaultValue>false</defaultValue>
        <description>If checked true, this video/review is highlighted in the Home Page &apos;What Our Valuable Customers Say&apos; section.</description>
        <label>Show on Home Page</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Verified_Visitor__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates the reviewer is verified as a real site visitor or buyer.</description>
        <label>Verified Visitor</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Customer_Location__c</fullName>
        <description>Reviewer&apos;s city or region (e.g., Chennai, Bengaluru, Dubai NRI).</description>
        <externalId>false</externalId>
        <label>Customer Location</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Quote_or_Feedback__c</fullName>
        <description>Full feedback text or highlighted quote from the customer.</description>
        <label>Quote or Feedback</label>
        <length>1500</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>4</visibleLines>
    </fields>
    <recordTypes>
        <fullName>Customer_Written_Review</fullName>
        <active>true</active>
        <description>Text-based verified customer site visit reviews and ratings.</description>
        <label>Customer Written Review</label>
        <picklistValues>
            <picklist>Review_Type__c</picklist>
            <values>
                <fullName>Video Testimonial</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Written Review</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Status__c</picklist>
            <values>
                <fullName>Approved</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Moderation</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Rejected</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <recordTypes>
        <fullName>Marketing_Video_Testimonial</fullName>
        <active>true</active>
        <description>YouTube video testimonials and property walkthroughs produced by the marketing team.</description>
        <label>Marketing Video Testimonial</label>
        <picklistValues>
            <picklist>Review_Type__c</picklist>
            <values>
                <fullName>Video Testimonial</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Written Review</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Status__c</picklist>
            <values>
                <fullName>Approved</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Pending Moderation</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Rejected</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
</CustomObject>