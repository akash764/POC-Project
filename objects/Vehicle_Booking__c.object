    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Manages complimentary chauffeur and vehicle bookings for customer site visits to UrbanNest developments.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <label>Vehicle Booking</label>
    <nameField>
        <displayFormat>VB-{0000}</displayFormat>
        <label>Booking Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Vehicle Bookings</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Lead__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Destination_Project__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Pickup_Time__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Vehicle_Type__c</customTabListAdditionalFields>
        <searchResultsAdditionalFields>Lead__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Destination_Project__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Pickup_Time__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Pickup_Address__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Vehicle_Number__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Lead__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Passenger / prospective buyer attending the site visit.</description>
        <label>Passenger (Lead)</label>
        <referenceTo>Lead</referenceTo>
        <relationshipLabel>Vehicle Bookings</relationshipLabel>
        <relationshipName>Vehicle_Bookings</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Driver__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Assigned chauffeur contact record from the UrbanNest fleet.</description>
        <label>Assigned Chauffeur (Contact)</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Contact.Is_Driver__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <infoMessage>Select an active chauffeur from the fleet (Contact with Is Driver = TRUE).</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Vehicle Bookings</relationshipLabel>
        <relationshipName>Vehicle_Bookings</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Chauffeur transit trip status.</description>
        <label>Status</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Requested</fullName>
                    <default>true</default>
                    <label>Requested</label>
                </value>
                <value>
                    <fullName>Driver Assigned</fullName>
                    <default>false</default>
                    <label>Driver Assigned</label>
                </value>
                <value>
                    <fullName>Picked Up</fullName>
                    <default>false</default>
                    <label>Picked Up</label>
                </value>
                <value>
                    <fullName>Arrived at Site</fullName>
                    <default>false</default>
                    <label>Arrived at Site</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Trip_Cost__c</fullName>
        <description>Internal developer travel expenditure for chauffeur/cab agency.</description>
        <label>Trip Cost</label>
        <precision>8</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Pickup_Time__c</fullName>
        <description>Scheduled departure date and time for chauffeur pickup.</description>
        <label>Pickup Date/Time</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Vehicle_Type__c</fullName>
        <description>Class of vehicle requested for transit.</description>
        <label>Vehicle Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Luxury Sedan</fullName>
                    <default>true</default>
                    <label>Luxury Sedan (Camry / Mercedes)</label>
                </value>
                <value>
                    <fullName>Premium SUV</fullName>
                    <default>false</default>
                    <label>Premium SUV (Innova Crysta)</label>
                </value>
                <value>
                    <fullName>Luxury EV</fullName>
                    <default>false</default>
                    <label>Luxury EV</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Pickup_Address__c</fullName>
        <description>Residential or office pickup location for the customer.</description>
        <externalId>false</externalId>
        <label>Pickup Address</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Vehicle_Number__c</fullName>
        <description>License plate registration number (e.g. TN-01-AB-1234).</description>
        <externalId>false</externalId>
        <label>Vehicle Reg Number</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Chauffeur_Phone__c</fullName>
        <externalId>false</externalId>
        <formula>Driver__r.Phone</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Chauffeur Phone</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Drop_Off_Location__c</fullName>
        <description>Destination drop-off location for the site visit trip.</description>
        <externalId>false</externalId>
        <label>Drop-off Location</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Destination_Project__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Target UrbanNest property development site being inspected.</description>
        <label>Destination Project</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Vehicle Bookings</relationshipLabel>
        <relationshipName>Vehicle_Bookings</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Site_Visit_Event_Id__c</fullName>
        <description>Salesforce 18-character Event record ID for the scheduled site visit appointment.</description>
        <externalId>false</externalId>
        <label>Site Visit Event ID</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Number_of_Passengers__c</fullName>
        <defaultValue>2</defaultValue>
        <description>Total family / passenger headcount.</description>
        <externalId>false</externalId>
        <label>Number of Passengers</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
</CustomObject>