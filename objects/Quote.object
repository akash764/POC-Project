    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <enableFeeds>false</enableFeeds>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <searchLayouts>
        <customTabListAdditionalFields>QUOTE.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>OPPORTUNITY.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>QUOTE.ISSYNCING</customTabListAdditionalFields>
        <customTabListAdditionalFields>QUOTE.EXPIRATIONDATE</customTabListAdditionalFields>
        <customTabListAdditionalFields>QUOTE.SUBTOTAL</customTabListAdditionalFields>
        <customTabListAdditionalFields>QUOTE.TOTALPRICE</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>QUOTE.NAME</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>OPPORTUNITY.NAME</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>QUOTE.ISSYNCING</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>QUOTE.EXPIRATIONDATE</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>QUOTE.SUBTOTAL</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>QUOTE.TOTALPRICE</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>QUOTE.NAME</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>OPPORTUNITY.NAME</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>QUOTE.ISSYNCING</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>QUOTE.EXPIRATIONDATE</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>QUOTE.SUBTOTAL</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>QUOTE.TOTALPRICE</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>QUOTE.PHONE</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>QUOTE.FAX</lookupPhoneDialogsAdditionalFields>
        <searchResultsAdditionalFields>QUOTE.NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Project_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Property_Unit_Name__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>QUOTE.STATUS</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>QUOTE.EXPIRATIONDATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Total_Agreement_Amount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Owner</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <fields>
        <fullName>Unit_Type__c</fullName>
        <description>Unit Configuration / BHK automatically inherited from the Property Unit.</description>
        <externalId>false</externalId>
        <formula>TEXT(Opportunity.Property_Unit__r.Unit_Type__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Unit Configuration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Base_Price__c</fullName>
        <description>Base unit price automatically inherited from the Opportunity.</description>
        <formula>Opportunity.Base_Price__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Base Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Project_Name__c</fullName>
        <description>Target Project name automatically inherited from the Opportunity.</description>
        <externalId>false</externalId>
        <formula>Opportunity.Project__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Target Project</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Payment_Scheme__c</fullName>
        <description>Agreed buyer payment milestone scheme.</description>
        <label>Payment Scheme</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Ready-to-Move (30 Days)</fullName>
                    <default>true</default>
                    <label>Ready-to-Move (30 Days)</label>
                </value>
                <value>
                    <fullName>Construction-Linked Plan (CLP)</fullName>
                    <default>false</default>
                    <label>Construction-Linked Plan (CLP)</label>
                </value>
                <value>
                    <fullName>Down Payment (10:90 Scheme)</fullName>
                    <default>false</default>
                    <label>Down Payment (10:90 Scheme)</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Amenities_Charge__c</fullName>
        <description>One-time amenities and infrastructure charge automatically inherited from the Opportunity.</description>
        <formula>Opportunity.Amenities_Charge__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Amenities &amp; Infrastructure Charge</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Property_Unit_Name__c</fullName>
        <description>Allocated Unit number automatically inherited from the Opportunity.</description>
        <externalId>false</externalId>
        <formula>Opportunity.Property_Unit__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Allocated / Shortlisted Unit</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Super_Built_Up_Area__c</fullName>
        <description>Total Super Built-Up Area in Sq.Ft automatically inherited from the Property Unit.</description>
        <externalId>false</externalId>
        <formula>Opportunity.Property_Unit__r.Super_Built_Up_Area__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Super Built-Up Area (Sq.Ft)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Booking_Token_Amount__c</fullName>
        <defaultValue>200000</defaultValue>
        <description>Initial booking token advance required to lock and reserve the property unit.</description>
        <label>Booking Token Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Total_Agreement_Amount__c</fullName>
        <description>Total agreement value automatically inherited from Opportunity total amount.</description>
        <formula>Opportunity.Amount</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Agreement Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Advance_Maintenance_Amount__c</fullName>
        <description>Advance maintenance amount automatically inherited from the Opportunity.</description>
        <formula>Opportunity.Advance_Maintenance_Amount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Advance Maintenance Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <type>Currency</type>
    </fields>
</CustomObject>