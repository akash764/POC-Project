    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Represents an apartment block or residential tower within an UrbanNest project.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <label>Apartment</label>
    <nameField>
        <label>Apartment Block Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Apartments</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Project__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Number_of_Units__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Available_Units__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Construction_Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Address__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Total_Floors__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Address__c</fullName>
        <description>Specific physical street address or wing location of the block.</description>
        <label>Address</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <description>Parent UrbanNest project owning this apartment block.</description>
        <label>Project</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Apartments</relationshipLabel>
        <relationshipName>Apartments</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Total_Floors__c</fullName>
        <description>Total number of floors in this block (ground floor is counted as 0).</description>
        <externalId>false</externalId>
        <label>Total Floors</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Available_Units__c</fullName>
        <description>Calculated count of residential units in this block with Status = Available.</description>
        <label>Available Units</label>
        <summaryFilterItems>
            <field>House_Unit__c.Status__c</field>
            <operation>equals</operation>
            <value>Available</value>
        </summaryFilterItems>
        <summaryForeignKey>House_Unit__c.Apartment__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Number_of_Units__c</fullName>
        <description>Calculated total count of residential units configured in this block.</description>
        <label>Number of Units</label>
        <summaryForeignKey>House_Unit__c.Apartment__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Photo_Content_Key__c</fullName>
        <description>Salesforce CMS Managed Content Key referencing approved photography for this block.</description>
        <externalId>false</externalId>
        <label>Photo Content Key</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Construction_Status__c</fullName>
        <description>Physical building completion stage.</description>
        <label>Construction Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Started</fullName>
                    <default>true</default>
                    <label>Not Started</label>
                </value>
                <value>
                    <fullName>Under Construction</fullName>
                    <default>false</default>
                    <label>Under Construction</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <validationRules>
        <fullName>Floor_Count_Not_Negative</fullName>
        <active>true</active>
        <errorConditionFormula>Total_Floors__c &lt;0</errorConditionFormula>
        <errorDisplayField>Total_Floors__c</errorDisplayField>
        <errorMessage>Floor Count Cannot be Negative</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Total_Floors_Nonnegative</fullName>
        <active>true</active>
        <description>Total floors count must be greater than or equal to zero.</description>
        <errorConditionFormula>Total_Floors__c &lt; 0</errorConditionFormula>
        <errorDisplayField>Total_Floors__c</errorDisplayField>
        <errorMessage>Total floors cannot be negative</errorMessage>
    </validationRules>
</CustomObject>