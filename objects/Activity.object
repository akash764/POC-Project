    <enableFeeds>false</enableFeeds>
    <searchLayouts>
        <searchResultsAdditionalFields>TASK.SUBJECT</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>TASK.WHO_NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>TASK.WHAT_NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>TASK.DUE_DATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CORE.USERS.ALIAS</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <fields>
        <fullName>Visit_Feedback__c</fullName>
        <description>Sales executive notes, observations, and buyer reactions following the walkthrough.</description>
        <label>Visit Feedback</label>
        <required>false</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Project_Visited__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Target UrbanNest real estate development inspected during the site visit.</description>
        <label>Project Visited</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Site Visits</relationshipLabel>
        <relationshipName>Site_Visits</relationshipName>
        <required>false</required>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Site_Visit_Status__c</fullName>
        <description>Lifecycle status of the site visit appointment.</description>
        <label>Site Visit Status</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Site Visit Scheduled</fullName>
                    <default>true</default>
                    <label>Site Visit Scheduled</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Cancelled</fullName>
                    <default>false</default>
                    <label>Cancelled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Transport_Required__c</fullName>
        <defaultValue>false</defaultValue>
        <description>When checked, automatically dispatches a complimentary chauffeur vehicle booking for the customer.</description>
        <label>Transport Required</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Site_Visit_Date_Time__c</fullName>
        <description>Single scheduled appointment time for the customer site walkthrough.</description>
        <label>Site Visit Date &amp; Time</label>
        <required>false</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Customer_Interest_Rating__c</fullName>
        <description>Buying intent rating after completing the site walkthrough.</description>
        <label>Customer Interest Rating</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Hot (Ready to Book)</fullName>
                    <default>false</default>
                    <label>Hot (Ready to Book)</label>
                </value>
                <value>
                    <fullName>Warm (Comparing Options)</fullName>
                    <default>true</default>
                    <label>Warm (Comparing Options)</label>
                </value>
                <value>
                    <fullName>Cold (Low Intent / Budget Issue)</fullName>
                    <default>false</default>
                    <label>Cold (Low Intent / Budget Issue)</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>