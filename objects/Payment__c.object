        <label>Payment Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Booking Token Advance</fullName>
                    <default>false</default>
                    <label>Booking Token Advance</label>
                </value>
                <value>
                    <fullName>Balance Settlement</fullName>
                    <default>false</default>
                    <label>Balance Settlement</label>
