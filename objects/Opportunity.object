    <compactLayoutAssignment>Opportunity_Compact_Layout</compactLayoutAssignment>
    <enableEnhancedLookup>true</enableEnhancedLookup>
    <enableFeeds>true</enableFeeds>
    <enableHistory>false</enableHistory>
    <externalSharingModel>Private</externalSharingModel>
    <searchLayouts>
        <customTabListAdditionalFields>OPPORTUNITY.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>ACCOUNT.NAME</customTabListAdditionalFields>
        <customTabListAdditionalFields>OPPORTUNITY.CLOSE_DATE</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>OPPORTUNITY.NAME</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>ACCOUNT.NAME</lookupDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>OPPORTUNITY.NAME</lookupPhoneDialogsAdditionalFields>
        <lookupPhoneDialogsAdditionalFields>ACCOUNT.NAME</lookupPhoneDialogsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ACCOUNT.NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Project__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Property_Unit__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.STAGE_NAME</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.AMOUNT</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>OPPORTUNITY.CLOSE_DATE</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CORE.USERS.FULL_NAME</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Read</sharingModel>
    <compactLayouts>
        <fullName>Opportunity_Compact_Layout</fullName>
        <fields>Name</fields>
        <fields>AccountId</fields>
        <fields>Project__c</fields>
        <fields>Property_Unit__c</fields>
        <fields>StageName</fields>
        <fields>Amount</fields>
        <fields>CloseDate</fields>
        <label>Opportunity Compact Layout</label>
    </compactLayouts>
    <compactLayouts>
        <fullName>New_Awesome_Companct_Layout</fullName>
        <fields>Name</fields>
        <fields>AccountId</fields>
        <fields>CloseDate</fields>
        <fields>Amount</fields>
        <fields>OwnerId</fields>
        <label>New Awesome Compact Layout</label>
    </compactLayouts>
    <fields>
        <fullName>Project__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Core Architecture Link: Relates the deal directly to the master project. Populated immediately upon Lead conversion. Child relationship: Opportunities.</description>
        <label>Target Project</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Opportunities</relationshipLabel>
        <relationshipName>Opportunities</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Base_Price__c</fullName>
        <description>Base unit price allocated to this opportunity from the property unit.</description>
        <label>Base Price</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Loss_Reason__c</fullName>
        <description>Required if Stage is Closed Lost: Budget Constraint, Bought from Competitor, Unit Layout Disliked, Vastu Incompatibility, Loan Rejection, Dropped Buying Plan.</description>
        <label>Closed Lost Reason</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Budget Constraint</fullName>
                    <default>false</default>
                    <label>Budget Constraint</label>
                </value>
                <value>
                    <fullName>Bought from Competitor</fullName>
                    <default>false</default>
                    <label>Bought from Competitor</label>
                </value>
                <value>
                    <fullName>Unit Layout Disliked</fullName>
                    <default>false</default>
                    <label>Unit Layout Disliked</label>
                </value>
                <value>
                    <fullName>Vastu Incompatibility</fullName>
                    <default>false</default>
                    <label>Vastu Incompatibility</label>
                </value>
                <value>
                    <fullName>Loan Rejection</fullName>
                    <default>false</default>
                    <label>Loan Rejection</label>
                </value>
                <value>
                    <fullName>Dropped Buying Plan</fullName>
                    <default>false</default>
                    <label>Dropped Buying Plan</label>
                </value>
                <value>
                    <fullName>Lost to Competitor</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Lost to Competitor</label>
                </value>
                <value>
                    <fullName>No Budget / Lost Funding</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>No Budget / Lost Funding</label>
                </value>
                <value>
                    <fullName>No Decision / Non-Responsive</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>No Decision / Non-Responsive</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Other</label>
                </value>
                <value>
                    <fullName>Price</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Price</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Property_Unit__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Core Architecture Link: Relates the deal to the specific unit. Optional during early prospecting/site visit; required before moving to Quote / Negotiation. Child relationship: Opportunities.</description>
        <label>Allocated / Shortlisted Unit</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Property_Unit__c.Phase__r.Project__c</field>
                <operation>equals</operation>
                <valueField>$Source.Project__c</valueField>
            </filterItems>
            <filterItems>
                <field>Property_Unit__c.Status__c</field>
                <operation>equals</operation>
                <value>Available</value>
            </filterItems>
            <infoMessage>Select an Available unit belonging to the target project.</infoMessage>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Property_Unit__c</referenceTo>
        <relationshipLabel>Opportunities</relationshipLabel>
        <relationshipName>Opportunities</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Amenities_Charge__c</fullName>
        <description>One-time amenities and infrastructure charge allocated from the property unit.</description>
        <label>Amenities &amp; Infrastructure Charge</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Budget_Confirmed__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Budget Confirmed</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Discovery_Completed__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Discovery Completed</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ROI_Analysis_Completed__c</fullName>
        <defaultValue>false</defaultValue>
        <label>ROI Analysis Completed</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Advance_Maintenance_Amount__c</fullName>
        <description>Advance Common Area Maintenance (CAM) amount allocated from the property unit.</description>
        <label>Advance Maintenance Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <validationRules>
        <fullName>Prevent_Allocating_Non_Available_Unit</fullName>
        <active>true</active>
        <description>Prevents allocating a property unit to an opportunity if the unit is already Under Offer, Reserved, or Sold to another buyer.</description>
        <errorConditionFormula>AND(
    ISCHANGED(Property_Unit__c),
    NOT(ISBLANK(Property_Unit__c)),
    TEXT(Property_Unit__r.Status__c) != &apos;Available&apos;
)</errorConditionFormula>
        <errorDisplayField>Property_Unit__c</errorDisplayField>
        <errorMessage>This unit is currently Under Offer, Reserved, or Sold. You can only select a unit with Status = Available.</errorMessage>
    </validationRules>
</CustomObject>