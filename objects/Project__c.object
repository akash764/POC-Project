    <fields>
        <fullName>Total_Apartments__c</fullName>
        <description>Calculated count of apartment blocks within this project.</description>
        <label>Total Apartments</label>
        <summaryForeignKey>Apartment__c.Project__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Total_Phases__c</fullName>
        <description>Auto-calculated roll-up summary count of child Phase records.</description>
        <label>Total Phases</label>
        <summaryForeignKey>Phase__c.Project__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <validationRules>
        <fullName>Budget_Nonnegative</fullName>
        <active>true</active>
        <description>Project budget must be greater than or equal to zero.</description>
        <errorConditionFormula>Budget__c &lt; 0</errorConditionFormula>
        <errorDisplayField>Budget__c</errorDisplayField>
        <errorMessage>Budget cannot be negative</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Project_Date_Range</fullName>
        <active>true</active>
        <description>End date must be on or after start date.</description>
        <errorConditionFormula>NOT(ISBLANK(Start_Date__c)) &amp;&amp; NOT(ISBLANK(End_Date__c)) &amp;&amp; End_Date__c &lt; Start_Date__c</errorConditionFormula>
        <errorDisplayField>End_Date__c</errorDisplayField>
        <errorMessage>End date must be on or after start date</errorMessage>
    </validationRules>
</CustomObject>
