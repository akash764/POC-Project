    <fields>
        <fullName>Maintenance_Rate_Per_SqFt__c</fullName>
        <description>Monthly Common Area Maintenance (CAM) rate per square foot for facility upkeep.</description>
        <inlineHelpText>Monthly CAM rate per sq.ft (e.g. ₹5.00 for residential, ₹15.00 for commercial).</inlineHelpText>
        <label>Maintenance Rate Per Sq.Ft (Monthly)</label>
        <precision>10</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
