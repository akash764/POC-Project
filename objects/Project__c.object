<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Advance_Maintenance_Years__c</fullName>
        <defaultValue>3</defaultValue>
        <description>Number of years of advance maintenance (CAM) collected upfront at possession (industry standard is 3 years).</description>
        <externalId>false</externalId>
        <inlineHelpText>Number of years of advance maintenance collected at possession (default is 3).</inlineHelpText>
        <label>Advance Maintenance (Years)</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Amenities_Infrastructure_Charge__c</fullName>
        <description>One-time clubhouse, lifestyle amenities, or commercial business infrastructure development fee.</description>
        <inlineHelpText>Enter the one-time amenities/infrastructure charge applicable to units in this project.</inlineHelpText>
        <label>Amenities &amp; Infrastructure Charge</label>
