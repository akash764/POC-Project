<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customErrors>
        <description>It will throw an error in the record page</description>
        <name>Block_Parent_Deletion</name>
        <label>Block Parent Deletion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>Can&apos;t Delete, Child Exists</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <description>This will block the deletion of the apartment record if the child exists.</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <interviewLabel>RT: Block The Deletion In Apartment Object {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RT: Block The Deletion In Apartment Object</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Block_Parent_Deletion</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Number_of_Units__c</field>
            <operator>GreaterThan</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>Phase__c</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
</Flow>
