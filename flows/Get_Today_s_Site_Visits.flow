            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Site_Visits_Found</name>
        <label>Check Site Visits Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Visits</defaultConnectorLabel>
        <rules>
            <name>Visits_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Today_s_Site_Visits</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_the_retrieved_records_to</targetReference>
            </connector>
            <label>Visits Found</label>
        </rules>
    </decisions>
    <description>Retrieves today&apos;s site visits for the requesting UrbanNest sales executive</description>
    <ends>
