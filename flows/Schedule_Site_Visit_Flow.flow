    <decisions>
        <name>Decision_Active_Booking_Exists</name>
        <label>Does Active Booking Exist?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Project_Vehicle_Bookings</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Active Booking</defaultConnectorLabel>
        <rules>
            <name>Rule_Active_Booking_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Active_Lead_Vehicle_Booking</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Error_Active_Booking</targetReference>
            </connector>
            <label>Active Booking Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Driver_Found</name>
        <label>Decision Driver Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_No_Driver</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Driver Available</defaultConnectorLabel>
        <rules>
            <name>Rule_Driver_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Available_Driver</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Driver_Found</targetReference>
            </connector>
            <label>Driver Available</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Email_Has_Recipient</name>
        <label>Has Customer Email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Confirmation_Success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Rule_Has_Email_With_Vehicle</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCustomerEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCustomerEmail</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Customer_Confirmation_Email</targetReference>
            </connector>
            <label>Has Email</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Email_Has_Recipient_No_Vehicle</name>
        <label>Has Customer Email (No Vehicle)?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Confirmation_Success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Rule_Has_Email_No_Vehicle</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCustomerEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varCustomerEmail</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Customer_Confirmation_Email_No_Vehicle</targetReference>
            </connector>
            <label>Has Email</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Project_Max_Limit</name>
        <label>Project Max Limit Reached?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Screen_Vehicle_Booking_Details</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Under Limit</defaultConnectorLabel>
        <rules>
            <name>Rule_Project_Limit_Exceeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varProjectBookingsCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Error_Max_Limit</targetReference>
            </connector>
            <label>Project Limit Exceeded</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Vehicle_Required</name>
        <label>Decision Vehicle Required?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Site_Visit_RecordType_No_Vehicle</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Vehicle Not Required</defaultConnectorLabel>
        <rules>
            <name>Rule_Vehicle_Required</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Input_Vehicle_Booking_Required</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Active_Lead_Vehicle_Booking</targetReference>
            </connector>
            <label>Vehicle Required</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>formulaCalculatedEventStatus</name>
        <dataType>String</dataType>
        <expression>IF({!formulaIsPastDate}, &quot;Completed&quot;, &quot;Site Visit Scheduled&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaCalculatedLeadStatus</name>
        <dataType>String</dataType>
        <expression>IF({!formulaIsPastDate}, &quot;Site Visit Completed&quot;, &quot;SIte_Visit_Scheduled&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaEffectiveEventOwner</name>
        <dataType>String</dataType>
        <expression>IF(LEFT({!Get_Lead_Record.OwnerId}, 3) = &quot;005&quot;, {!Get_Lead_Record.OwnerId}, {!$User.Id})</expression>
    </formulas>
    <formulas>
        <name>formulaIncrementedTotalBookings</name>
        <dataType>Number</dataType>
        <expression>IF(ISBLANK({!Get_Lead_Record.Total_Vehicle_Booking__c}), 1, {!Get_Lead_Record.Total_Vehicle_Booking__c} + 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>formulaIsPastDate</name>
        <dataType>Boolean</dataType>
        <expression>{!Input_End_DateTime} &lt;= NOW()</expression>
    </formulas>
    <formulas>
        <name>formulaNow</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>formulaTwoHoursLater</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + 0.0833</expression>
    </formulas>
    <interviewLabel>Schedule Site Visit Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Schedule Site Visit Flow</label>
    <loops>
        <name>Loop_Count_Project_Bookings</name>
        <label>Count Project Bookings</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Project_Vehicle_Bookings</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Increment_Project_Count</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Decision_Project_Max_Limit</targetReference>
        </noMoreValuesConnector>
    </loops>
