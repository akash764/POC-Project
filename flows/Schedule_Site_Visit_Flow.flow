            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Pickup_Location</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Input_Location</elementReference>
            </defaultValue>
            <fieldText>Pickup Location / Address</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Dropoff_Location</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>Input_Location</elementReference>
            </defaultValue>
            <fieldText>Drop-off Location (Site Visit Location)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Pickup_DateTime</name>
            <dataType>DateTime</dataType>
            <defaultValue>
                <elementReference>Input_Start_DateTime</elementReference>
            </defaultValue>
            <fieldText>Pickup Date &amp; Time</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Vehicle_Type</name>
            <choiceReferences>Choice_Luxury_Sedan</choiceReferences>
            <choiceReferences>Choice_Executive_SUV</choiceReferences>
            <choiceReferences>Choice_Premium_Van</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>Choice_Luxury_Sedan</defaultSelectedChoiceReference>
            <fieldText>Vehicle Type</fieldText>
            <fieldType>DropdownBox</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Passengers</name>
            <dataType>Number</dataType>
            <defaultValue>
                <numberValue>2.0</numberValue>
            </defaultValue>
            <fieldText>Number of Passengers</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>0</scale>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Lead_Record</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttDefaultSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
