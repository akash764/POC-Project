<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Send_Customer_Confirmation_Email</name>
        <label>Send Customer Confirmation Email (With Vehicle)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Screen_Confirmation_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Confirmation_Success</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>varCustomerEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Site Visit &amp; Chauffeur Booking Confirmation - UrbanNest</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Dear {!varCustomerName},

Your Site Visit and Chauffeur Service have been successfully confirmed.

Site Visit Details:
- Date &amp; Start Time: {!Input_Start_DateTime}
- End Time: {!Input_End_DateTime}
- Location / Project: {!Input_Location}

Chauffeur &amp; Vehicle Pickup Details:
- Pickup Address: {!Input_Pickup_Location}
- Drop-off Location: {!Input_Dropoff_Location}
- Pickup Time: {!Input_Pickup_DateTime}
- Vehicle Category: {!Input_Vehicle_Type}
- Number of Passengers: {!Input_Passengers}
- Assigned Chauffeur: {!varAssignedDriverName} ({!varAssignedDriverPhone})

Thank you,
UrbanNest Operations &amp; Client Services</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <actionCalls>
        <name>Send_Customer_Confirmation_Email_No_Vehicle</name>
        <label>Send Customer Confirmation Email (No Vehicle)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Screen_Confirmation_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Confirmation_Success</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>varCustomerEmail</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Site Visit Confirmation - UrbanNest</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <stringValue>Dear {!varCustomerName},

Your Site Visit has been successfully scheduled.

Site Visit Details:
- Date &amp; Start Time: {!Input_Start_DateTime}
- End Time: {!Input_End_DateTime}
- Location / Project: {!Input_Location}

Thank you,
UrbanNest Sales Team</stringValue>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Driver_Found</name>
        <label>Assign Driver Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varAssignedDriverId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Available_Driver.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
