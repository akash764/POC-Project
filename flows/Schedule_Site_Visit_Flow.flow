    <recordUpdates>
        <name>Update_Lead_Record_With_Vehicle</name>
        <label>Update Lead Record (With Vehicle)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Decision_Email_Has_Recipient</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Flow_Fault_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varLeadId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>formulaCalculatedLeadStatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
