        </connector>
    </assignments>
    <assignments>
        <name>Assign_Increment_Project_Count</name>
        <label>Increment Project Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varProjectBookingsCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Count_Project_Bookings</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Lead_Details</name>
