            <operator>Assign</operator>
            <value>
                <elementReference>Get_Available_Driver.Name</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAssignedDriverPhone</assignToReference>
            <operator>Assign</operator>
            <value>
