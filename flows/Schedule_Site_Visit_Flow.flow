    <runInMode>SystemModeWithoutSharing</runInMode>
    <screens>
        <name>Screen_Confirmation_Success</name>
        <label>Booking Confirmed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Success_Msg</name>
            <fieldText>&lt;div style=&apos;padding: 16px; background-color: #E6F4EA; border-left: 6px solid #137333; border-radius: 4px;&apos;&gt;
&lt;h3 style=&apos;color: #137333; margin: 0 0 8px 0;&apos;&gt;Site Visit Successfully Scheduled!&lt;/h3&gt;
&lt;p style=&apos;margin: 0; color: #202124;&apos;&gt;The appointment has been scheduled, and the Lead status has been updated to &lt;b&gt;Site Visit Scheduled&lt;/b&gt;.&lt;/p&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Display_Summary_Details</name>
            <fieldText>&lt;br/&gt;
&lt;p&gt;&lt;b&gt;Customer:&lt;/b&gt; {!varCustomerName} ({!varCustomerPhone})&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Scheduled Time:&lt;/b&gt; {!Input_Start_DateTime} to {!Input_End_DateTime}&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Project / Location:&lt;/b&gt; {!Input_Location}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Error_Active_Booking</name>
        <label>Active Booking Exists</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Active_Booking_Error</name>
            <fieldText>&lt;div style=&apos;padding: 16px; background-color: #FCE8E6; border-left: 6px solid #C5221F; border-radius: 4px;&apos;&gt;
&lt;h3 style=&apos;color: #C5221F; margin: 0 0 8px 0;&apos;&gt;Active Vehicle Booking Already Exists&lt;/h3&gt;
&lt;p style=&apos;margin: 0; color: #202124;&apos;&gt;An active Vehicle Booking (&lt;b&gt;{!Get_Active_Lead_Vehicle_Booking.Name}&lt;/b&gt; - Status: &lt;b&gt;{!Get_Active_Lead_Vehicle_Booking.Status__c}&lt;/b&gt;) already exists for this Lead.&lt;br/&gt;&lt;br/&gt;You cannot create another vehicle booking until the existing booking is &lt;b&gt;Completed&lt;/b&gt; or &lt;b&gt;Cancelled&lt;/b&gt;.&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Click &lt;b&gt;Previous&lt;/b&gt; to uncheck Vehicle Booking and schedule the Site Visit alone, or click &lt;b&gt;Finish&lt;/b&gt; to exit.&lt;/i&gt;&lt;/p&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Error_Max_Limit</name>
        <label>Maximum Limit Reached</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Max_Limit_Error</name>
            <fieldText>&lt;div style=&apos;padding: 16px; background-color: #FCE8E6; border-left: 6px solid #C5221F; border-radius: 4px;&apos;&gt;
&lt;h3 style=&apos;color: #C5221F; margin: 0 0 8px 0;&apos;&gt;Maximum Vehicle Booking Limit Reached for Project&lt;/h3&gt;
&lt;p style=&apos;margin: 0; color: #202124;&apos;&gt;A maximum of &lt;b&gt;3 vehicle bookings&lt;/b&gt; are permitted per project for a lead. This lead already has &lt;b&gt;{!varProjectBookingsCount}&lt;/b&gt; vehicle bookings registered for project &lt;b&gt;{!varProjectName}&lt;/b&gt;.&lt;br/&gt;&lt;br/&gt;You cannot request another vehicle booking for this project.&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Click &lt;b&gt;Previous&lt;/b&gt; to uncheck Vehicle Booking and schedule the Site Visit alone, or click &lt;b&gt;Finish&lt;/b&gt; to exit.&lt;/i&gt;&lt;/p&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Flow_Fault_Error</name>
        <label>Error Scheduling Site Visit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Flow_Fault</name>
            <fieldText>&lt;div style=&quot;padding: 16px; background-color: #FFF2F2; border: 1px solid #EA001E; border-radius: 8px;&quot;&gt;
&lt;h3 style=&quot;color: #BA0517; margin-top: 0;&quot;&gt;⚠️ Unable to Schedule Site Visit&lt;/h3&gt;
&lt;p style=&quot;color: #374151; font-size: 13px;&quot;&gt;&lt;b&gt;Error Details:&lt;/b&gt; {!$Flow.FaultMessage}&lt;/p&gt;
&lt;p style=&quot;color: #6B7280; font-size: 12px;&quot;&gt;Please review the entered details or click Previous to adjust.&lt;/p&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Site_Visit_Details</name>
        <label>Schedule Site Visit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Decision_Vehicle_Required</targetReference>
        </connector>
        <fields>
            <name>Display_Customer_Banner</name>
            <fieldText>&lt;div style=&apos;padding: 12px 16px; background-color: #E8F0FE; border-left: 5px solid #1A73E8; border-radius: 4px; margin-bottom: 12px;&apos;&gt;
&lt;b style=&apos;color: #174EA6; font-size: 14px;&apos;&gt;Customer:&lt;/b&gt; {!varCustomerName} &amp;nbsp;|&amp;nbsp; 
&lt;b style=&apos;color: #174EA6; font-size: 14px;&apos;&gt;Phone:&lt;/b&gt; {!varCustomerPhone} &amp;nbsp;|&amp;nbsp; 
&lt;b style=&apos;color: #174EA6; font-size: 14px;&apos;&gt;Email:&lt;/b&gt; {!varCustomerEmail}
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Subject</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>varDefaultSubject</elementReference>
            </defaultValue>
            <fieldText>Subject</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Start_DateTime</name>
            <dataType>DateTime</dataType>
            <defaultValue>
                <elementReference>formulaNow</elementReference>
            </defaultValue>
            <fieldText>Site Visit Start Date &amp; Time</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_End_DateTime</name>
            <dataType>DateTime</dataType>
            <defaultValue>
                <elementReference>formulaTwoHoursLater</elementReference>
            </defaultValue>
            <fieldText>Site Visit End Date &amp; Time</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Location</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>varDefaultLocation</elementReference>
            </defaultValue>
            <fieldText>Site Visit Location</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Description</name>
            <fieldText>Description / Special Instructions</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Input_Vehicle_Booking_Required</name>
            <dataType>Boolean</dataType>
            <defaultValue>
                <booleanValue>false</booleanValue>
            </defaultValue>
            <fieldText>Vehicle Booking Required?</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Vehicle_Booking_Details</name>
        <label>Chauffeur &amp; Vehicle Booking Details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Get_Available_Driver</targetReference>
        </connector>
        <fields>
