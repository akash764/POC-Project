<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Convert_Lead_With_Allocation</name>
        <label>Convert Lead With Allocation</label>
        <locationX>446</locationX>
        <locationY>458</locationY>
        <actionName>UNLeadConvertInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Decision_Convert_Success</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Screen_Conversion_Error</targetReference>
        </faultConnector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>leadId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>ownerId</name>
            <value>
                <elementReference>formulaSelectedOwnerId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>convertedStatus</name>
            <value>
                <elementReference>Input_Converted_Status</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>existingAccountId</name>
            <value>
                <elementReference>formulaSelectedExistingAccountId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>accountRecordType</name>
            <value>
                <elementReference>formulaSelectedAccountRecordType</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>accountName</name>
            <value>
                <elementReference>formulaSelectedAccountName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>existingContactId</name>
            <value>
                <elementReference>formulaSelectedExistingContactId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>contactRole</name>
            <value>
                <elementReference>Input_Contact_Role</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>doNotCreateOpportunity</name>
            <value>
                <elementReference>formulaDoNotCreateOpportunity</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>existingOpportunityId</name>
            <value>
                <elementReference>formulaSelectedExistingOpportunityId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>opportunityName</name>
            <value>
                <elementReference>formulaSelectedOpportunityName</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>projectId</name>
            <value>
                <elementReference>Get_Lead.Preferred_Project__c</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>propertyUnitId</name>
            <value>
                <elementReference>formulaSelectedUnitId</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>closeDate</name>
            <value>
                <elementReference>formulaEffectiveCloseDate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>UNLeadConvertInvocable</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <choices>
        <name>Choice_Auth_Signatory</name>
        <choiceText>Authorized Signatory</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Authorized Signatory</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Billing_Contact</name>
        <choiceText>Billing / Accounts Contact</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Billing / Accounts Contact</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Co_Applicant</name>
        <choiceText>Co-Applicant</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Co-Applicant</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Corporate_Buyer</name>
        <choiceText>Corporate Buyer</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Corporate_Buyer</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Individual_Buyer</name>
        <choiceText>Individual Buyer</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Individual_Buyer</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Other</name>
        <choiceText>Other</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Other</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Primary_Applicant</name>
        <choiceText>Primary Applicant</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Primary Applicant</stringValue>
        </value>
    </choices>
    <choices>
        <name>Choice_Status_Qualified</name>
        <choiceText>Qualified / Converted</choiceText>
        <dataType>String</dataType>
        <value>
            <stringValue>Qualified</stringValue>
        </value>
    </choices>
    <decisions>
        <name>Decision_Convert_Success</name>
        <label>Did Conversion Succeed?</label>
        <locationX>446</locationX>
        <locationY>566</locationY>
        <defaultConnector>
            <targetReference>Screen_Conversion_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Conversion Failed</defaultConnectorLabel>
        <rules>
            <name>Rule_Convert_Success</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Convert_Lead_With_Allocation.isSuccess</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Conversion_Success</targetReference>
            </connector>
            <label>Conversion Succeeded</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Is_Already_Converted</name>
        <label>Is Lead Already Converted?</label>
        <locationX>248</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Screen_Convert_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unconverted</defaultConnectorLabel>
        <rules>
            <name>Rule_Already_Converted</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.IsConverted</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Already_Converted</targetReference>
            </connector>
            <label>Already Converted</label>
        </rules>
    </decisions>
    <description>Lead Conversion Modal with Right-Side &apos;Choose Existing&apos; Toggles, dynamic left-side locking, real estate allocation, and mandatory Bottom Controls.</description>
    <dynamicChoiceSets>
        <name>rcs_Available_Property_Units</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Project__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Lead.Preferred_Project__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Available</stringValue>
            </value>
        </filters>
        <object>Property_Unit__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>formulaDefaultAccountName</name>
        <dataType>String</dataType>
        <expression>IF({!Radio_Account_Record_Type} = &quot;Corporate_Buyer&quot;, IF(NOT(ISBLANK({!Get_Lead.Company})), {!Get_Lead.Company}, {!Get_Lead.Name}), {!Get_Lead.Name})</expression>
    </formulas>
    <formulas>
        <name>formulaDefaultCloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 10</expression>
    </formulas>
    <formulas>
        <name>formulaDefaultOppName</name>
        <dataType>String</dataType>
        <expression>{!Get_Lead.Name} &amp; &quot; - &quot; &amp; IF(NOT(ISBLANK({!Get_Lead.Preferred_Project__r.Name})), {!Get_Lead.Preferred_Project__r.Name}, &quot;Deal&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaDoNotCreateOpportunity</name>
        <dataType>Boolean</dataType>
        <expression>IF({!Toggle_Opp_Existing.value} = false, {!Checkbox_Do_Not_Create_Opp}, false)</expression>
    </formulas>
    <formulas>
        <name>formulaEffectiveCloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Input_Close_Date}), TODAY() + 10, {!Input_Close_Date})</expression>
    </formulas>
    <formulas>
        <name>formulaSelectedAccountName</name>
        <dataType>String</dataType>
        <expression>IF({!Toggle_Account_Existing.value} = false, {!Input_Account_Name}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaSelectedAccountRecordType</name>
        <dataType>String</dataType>
        <expression>IF({!Toggle_Account_Existing.value} = false, {!Radio_Account_Record_Type}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaSelectedExistingAccountId</name>
        <dataType>String</dataType>
        <expression>IF({!Toggle_Account_Existing.value} = true, {!Lookup_Existing_Account.recordId}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaSelectedExistingContactId</name>
        <dataType>String</dataType>
        <expression>IF({!Toggle_Contact_Existing.value} = true, {!Lookup_Existing_Contact.recordId}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaSelectedExistingOpportunityId</name>
        <dataType>String</dataType>
        <expression>IF({!Toggle_Opp_Existing.value} = true, {!Lookup_Existing_Opportunity.recordId}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaSelectedOpportunityName</name>
        <dataType>String</dataType>
        <expression>IF({!Toggle_Opp_Existing.value} = false &amp;&amp; {!Checkbox_Do_Not_Create_Opp} = false, {!Input_Opportunity_Name}, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>formulaSelectedOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Lookup_Record_Owner.recordId})), {!Lookup_Record_Owner.recordId}, {!Get_Lead.OwnerId})</expression>
    </formulas>
    <formulas>
        <name>formulaSelectedUnitId</name>
        <dataType>String</dataType>
        <expression>IF({!Toggle_Allocate_Unit.value} = true &amp;&amp; {!Checkbox_Do_Not_Create_Opp} = false &amp;&amp; {!Toggle_Opp_Existing.value} = false, {!Dropdown_Property_Unit}, &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Convert Lead Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Convert Lead Screen Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Lead</name>
        <label>Get Lead Details</label>
        <locationX>248</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Is_Already_Converted</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Screen_Already_Converted</name>
        <label>Lead Already Converted</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Already_Converted</name>
            <fieldText>&lt;div style=&quot;padding: 16px; background-color: #FFFBE6; border: 1px solid #FFD666; border-radius: 8px;&quot;&gt;
&lt;h3 style=&quot;color: #D48806; margin-top: 0;&quot;&gt;ℹ️ Lead Already Converted&lt;/h3&gt;
&lt;p&gt;This Lead has already been converted into an Account, Contact, and Opportunity.&lt;/p&gt;
&lt;p&gt;👉 &lt;a href=&quot;/lightning/r/Opportunity/{!Get_Lead.ConvertedOpportunityId}/view&quot; target=&quot;_top&quot; style=&quot;font-weight: bold; color: #0070D2;&quot;&gt;Open Converted Opportunity&lt;/a&gt;&lt;/p&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Conversion_Error</name>
        <label>Conversion Failed</label>
        <locationX>578</locationX>
        <locationY>674</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Error_Message</name>
            <fieldText>&lt;div style=&quot;padding: 16px; background-color: #FFF2F2; border: 1px solid #EA001E; border-radius: 8px;&quot;&gt;
&lt;h3 style=&quot;color: #BA0517; margin-top: 0;&quot;&gt;⚠️ Lead Conversion Error&lt;/h3&gt;
&lt;p&gt;{!Convert_Lead_With_Allocation.errorMessage}&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Details:&lt;/b&gt; {!$Flow.FaultMessage}&lt;/p&gt;
&lt;p&gt;Please verify the Lead details and try again.&lt;/p&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Conversion_Success</name>
        <label>Conversion Succeeded</label>
        <locationX>314</locationX>
        <locationY>674</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Display_Success_Message</name>
            <fieldText>&lt;div style=&quot;padding: 16px; background-color: #F0FBF6; border: 1px solid #45C68A; border-radius: 8px;&quot;&gt;
&lt;h3 style=&quot;color: #107C41; margin-top: 0;&quot;&gt;🎉 Lead Converted Successfully!&lt;/h3&gt;
&lt;p&gt;The prospect has been converted into customer records as per your selection:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;b&gt;Account Mode:&lt;/b&gt; {!formulaSelectedAccountName}&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Contact Role:&lt;/b&gt; {!Input_Contact_Role}&lt;/li&gt;
&lt;li&gt;&lt;b&gt;Target Project:&lt;/b&gt; {!Get_Lead.Preferred_Project__r.Name}&lt;/li&gt;
&lt;/ul&gt;
&lt;p style=&quot;margin-top: 14px;&quot;&gt;👉 &lt;a href=&quot;/lightning/r/Account/{!Convert_Lead_With_Allocation.accountId}/view&quot; target=&quot;_top&quot; style=&quot;font-size: 15px; font-weight: bold; color: #0070D2; margin-right: 18px;&quot;&gt;View Account&lt;/a&gt;
&lt;a href=&quot;/lightning/r/Opportunity/{!Convert_Lead_With_Allocation.opportunityId}/view&quot; target=&quot;_top&quot; style=&quot;font-size: 15px; font-weight: bold; color: #0070D2;&quot;&gt;View Opportunity&lt;/a&gt;&lt;/p&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Convert_Lead</name>
        <label>Convert Lead</label>
        <locationX>446</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Convert_Lead_With_Allocation</targetReference>
        </connector>
        <fields>
            <name>Display_Lead_Summary</name>
            <fieldText>&lt;div style=&quot;background: #F8F9FA; padding: 10px 14px; border: 1px solid #E5E7EB; border-radius: 6px; margin-bottom: 12px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; align-items: center;&quot;&gt;
&lt;div&gt;&lt;span style=&quot;font-weight: bold; font-size: 14px; color: #111827;&quot;&gt;👤 Prospect: {!Get_Lead.Name}&lt;/span&gt; &amp;nbsp;|&amp;nbsp; &lt;span style=&quot;color: #4B5563;&quot;&gt;{!Get_Lead.Company}&lt;/span&gt;&lt;/div&gt;
&lt;div style=&quot;color: #6B7280; font-size: 13px;&quot;&gt;&amp;nbsp;&amp;nbsp;Email: {!Get_Lead.Email} &amp;nbsp;•&amp;nbsp; Phone: {!Get_Lead.Phone}&lt;/div&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Header_Account_Section</name>
            <fieldText>&lt;div style=&quot;border-bottom: 2px solid #0070D2; padding-bottom: 4px; margin-top: 10px; margin-bottom: 8px;&quot;&gt;
&lt;span style=&quot;font-size: 15px; font-weight: bold; color: #0070D2;&quot;&gt;🏢 1. Account&lt;/span&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Screen_Convert_Lead_Section1</name>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>Screen_Convert_Lead_Section1_Column1</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>Label_Account_New</name>
                    <fieldText>&lt;div style=&quot;font-weight: 600; color: #0176D3; font-size: 13px; margin-bottom: 4px;&quot;&gt;Create New Account&lt;/div&gt;</fieldText>
                    <fieldType>DisplayText</fieldType>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Toggle_Account_Existing.value</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>false</booleanValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>Input_Account_Name</name>
                    <dataType>String</dataType>
                    <defaultValue>
                        <elementReference>formulaDefaultAccountName</elementReference>
                    </defaultValue>
                    <fieldText>Account Name</fieldText>
                    <fieldType>InputField</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>false</isRequired>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Toggle_Account_Existing.value</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>false</booleanValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>Radio_Account_Record_Type</name>
                    <choiceReferences>Choice_Individual_Buyer</choiceReferences>
                    <choiceReferences>Choice_Corporate_Buyer</choiceReferences>
                    <dataType>String</dataType>
                    <defaultSelectedChoiceReference>Choice_Individual_Buyer</defaultSelectedChoiceReference>
                    <fieldText>Record Type</fieldText>
                    <fieldType>RadioButtons</fieldType>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>false</isRequired>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Toggle_Account_Existing.value</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>false</booleanValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>Display_Account_Locked</name>
                    <fieldText>&lt;div style=&quot;padding: 14px; background: #F4F6F9; border: 1px solid #D8DDE6; border-radius: 6px; margin-top: 4px;&quot;&gt;
&lt;div style=&quot;font-size: 13px; font-weight: bold; color: #706E6B; margin-bottom: 4px;&quot;&gt;🔒 Create New Account (Disabled)&lt;/div&gt;
&lt;p style=&quot;margin: 0; font-size: 12px; color: #706E6B;&quot;&gt;Account creation is disabled because &lt;b&gt;Choose Existing Account&lt;/b&gt; is toggled ON. Select matching account on the right.&lt;/p&gt;
&lt;/div&gt;</fieldText>
                    <fieldType>DisplayText</fieldType>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                    <visibilityRule>
                        <conditionLogic>and</conditionLogic>
                        <conditions>
                            <leftValueReference>Toggle_Account_Existing.value</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>true</booleanValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>6</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <fields>
                <name>Screen_Convert_Lead_Section1_Column2</name>
                <fieldType>Region</fieldType>
                <fields>
                    <name>Toggle_Account_Existing</name>
                    <extensionName>flowruntime:toggle</extensionName>
                    <fieldType>ComponentInstance</fieldType>
                    <inputParameters>
                        <name>label</name>
                        <value>
                            <stringValue>Choose Existing Account</stringValue>
                        </value>
                    </inputParameters>
                    <inputParameters>
                        <name>messageToggleActive</name>
                        <value>
                            <stringValue>Yes - Link Existing</stringValue>
                        </value>
                    </inputParameters>
                    <inputParameters>
                        <name>messageToggleInactive</name>
                        <value>
