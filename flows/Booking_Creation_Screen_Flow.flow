    <decisions>
        <name>Decision_Active_Booking_Exists</name>
        <label>Active Booking Exists?</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <defaultConnector>
            <targetReference>Get_Confirmed_Quote</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Active Booking</defaultConnectorLabel>
        <rules>
            <name>Rule_Booking_Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Booking.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Booking_Already_Exists</targetReference>
            </connector>
            <label>Booking Already Exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Decision_Has_Booked_Unit</name>
        <label>Has Booked Unit?</label>
        <locationX>578</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Screen_Success</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Unit Allocated</defaultConnectorLabel>
        <rules>
            <name>Rule_Unit_Selected</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>formulaEffectiveBookedUnitId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Booked_Unit_Status</targetReference>
            </connector>
            <label>Unit Selected</label>
        </rules>
    </decisions>
    <description>Screen flow launched from Opportunity to create a Booking record with pre-populated Primary Buyer, Project, Booked Unit, Source Deal, Token Received status, and Confirmed Quote Final Sale Price, updating Unit status to Under Offer.</description>
    <dynamicChoiceSets>
        <name>BookingStatus</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Booking_Status__c</picklistField>
        <picklistObject>Booking__c</picklistObject>
    </dynamicChoiceSets>
    <ends>
        <name>END_ELEMENT_4</name>
        <locationX>50</locationX>
        <locationY>566</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_5</name>
        <locationX>578</locationX>
        <locationY>1106</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_6</name>
        <locationX>578</locationX>
        <locationY>1430</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <name>formulaEffectiveBookedUnitId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Lookup_Booked_Unit.recordId})), {!Lookup_Booked_Unit.recordId}, {!Get_Opportunity.Property_Unit__c})</expression>
    </formulas>
    <formulas>
        <name>formulaEffectiveBuyerId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Lookup_Primary_Buyer.recordId})), {!Lookup_Primary_Buyer.recordId}, {!Get_Opportunity.AccountId})</expression>
    </formulas>
    <formulas>
        <name>formulaEffectiveProjectId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Lookup_Project.recordId})), {!Lookup_Project.recordId}, {!Get_Opportunity.Project__c})</expression>
    </formulas>
    <formulas>
        <name>formulaEffectiveSourceDealId</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!Lookup_Source_Deal.recordId})), {!Lookup_Source_Deal.recordId}, {!Get_Opportunity.Id})</expression>
    </formulas>
    <formulas>
        <name>formulaFinalPrice</name>
        <dataType>Currency</dataType>
        <expression>IF(NOT(ISBLANK({!Get_Confirmed_Quote.Total_Agreement_Amount__c})), {!Get_Confirmed_Quote.Total_Agreement_Amount__c}, IF(NOT(ISBLANK({!Get_Confirmed_Quote.TotalPrice})), {!Get_Confirmed_Quote.TotalPrice}, {!Get_Opportunity.Amount}))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Create Booking {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Create Booking Screen Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Booking_Record</name>
        <label>Create Booking Record</label>
        <locationX>578</locationX>
        <locationY>674</locationY>
        <assignRecordIdToReference>varCreatedBookingId</assignRecordIdToReference>
        <connector>
            <targetReference>Decision_Has_Booked_Unit</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Account__c</field>
            <value>
                <elementReference>formulaEffectiveBuyerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Booking_Date__c</field>
            <value>
                <elementReference>Input_Date_of_Booking</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Booking_Status__c</field>
            <value>
                <stringValue>Waiting Token Payement</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Final_Agreed_Price__c</field>
            <value>
                <elementReference>Input_Final_Sale_Price</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Opportunity__c</field>
            <value>
                <elementReference>formulaEffectiveSourceDealId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project__c</field>
            <value>
                <elementReference>formulaEffectiveProjectId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Property_Unit__c</field>
            <value>
                <elementReference>formulaEffectiveBookedUnitId</elementReference>
            </value>
        </inputAssignments>
        <object>Booking__c</object>
    </recordCreates>
    <recordLookups>
        <name>Get_Confirmed_Quote</name>
        <label>Get Confirmed Quote</label>
        <locationX>578</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Screen_New_Booking</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Confirmed</stringValue>
            </value>
        </filters>
        <filters>
            <field>IsSyncing</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <sortField>LastModifiedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Booking</name>
        <label>Get Existing Active Booking</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Active_Booking_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Opportunity__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Booking_Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Booking__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opportunity</name>
        <label>Get Current Opportunity</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Existing_Booking</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Booked_Unit_Status</name>
        <label>Update Booked Unit to Under Offer</label>
        <locationX>314</locationX>
        <locationY>890</locationY>
        <connector>
            <targetReference>Screen_Success</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Screen_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>formulaEffectiveBookedUnitId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Under Offer</stringValue>
            </value>
        </inputAssignments>
        <object>Property_Unit__c</object>
    </recordUpdates>
    <screens>
        <name>Screen_Booking_Already_Exists</name>
        <label>Active Booking Exists</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>END_ELEMENT_4</targetReference>
        </connector>
        <fields>
            <name>Display_Booking_Exists_Warning</name>
            <fieldText>&lt;div style=&quot;padding: 20px; background-color: #FFFBE6; border: 1px solid #FFE58F; border-radius: 8px;&quot;&gt;
&lt;div style=&quot;display: flex; align-items: center; margin-bottom: 12px;&quot;&gt;
&lt;span style=&quot;font-size: 24px; margin-right: 8px;&quot;&gt;⚠️&lt;/span&gt;
&lt;h2 style=&quot;color: #D46B08; font-size: 18px; font-weight: bold; margin: 0;&quot;&gt;Active Booking Already Exists&lt;/h2&gt;
&lt;/div&gt;
&lt;p style=&quot;color: #374151; font-size: 14px; margin-bottom: 12px;&quot;&gt;An active booking (&lt;b&gt;{!Get_Existing_Booking.Name}&lt;/b&gt;) is already linked to this Opportunity. Under our business rules, only one active booking can be associated with a deal.&lt;/p&gt;
&lt;div style=&quot;background-color: #FFFFFF; padding: 12px; border: 1px solid #E5E7EB; border-radius: 6px; margin-bottom: 16px;&quot;&gt;
&lt;p style=&quot;margin: 4px 0; font-size: 13px;&quot;&gt;&lt;b&gt;Booking Number:&lt;/b&gt; {!Get_Existing_Booking.Name}&lt;/p&gt;
&lt;p style=&quot;margin: 4px 0; font-size: 13px;&quot;&gt;&lt;b&gt;Booking Status:&lt;/b&gt; {!Get_Existing_Booking.Booking_Status__c}&lt;/p&gt;
&lt;p style=&quot;margin: 4px 0; font-size: 13px;&quot;&gt;&lt;b&gt;Booking Date:&lt;/b&gt; {!Get_Existing_Booking.Booking_Date__c}&lt;/p&gt;
&lt;p style=&quot;margin: 4px 0; font-size: 13px;&quot;&gt;&lt;b&gt;Agreed Price:&lt;/b&gt; {!Get_Existing_Booking.Final_Agreed_Price__c}&lt;/p&gt;
&lt;/div&gt;
&lt;div style=&quot;text-align: center;&quot;&gt;
&lt;a href=&quot;/lightning/r/Booking__c/{!Get_Existing_Booking.Id}/view&quot; target=&quot;_top&quot; style=&quot;display: inline-block; padding: 10px 20px; background-color: #0070D2; color: #FFFFFF; font-weight: bold; text-decoration: none; border-radius: 6px;&quot;&gt;View Existing Booking Record&lt;/a&gt;
&lt;/div&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Screen_Error</name>
        <label>Error</label>
        <locationX>578</locationX>
        <locationY>998</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>END_ELEMENT_5</targetReference>
        </connector>
        <fields>
            <name>Display_Fault_Error</name>
            <fieldText>&lt;div style=&quot;padding: 16px; background-color: #FFF2F2; border: 1px solid #EA001E; border-radius: 8px;&quot;&gt;
&lt;h3 style=&quot;color: #BA0517; margin-top: 0;&quot;&gt;Booking Could Not Be Completed&lt;/h3&gt;
&lt;p style=&quot;color: #374151; font-size: 13px;&quot;&gt;&lt;b&gt;Error Details:&lt;/b&gt; {!$Flow.FaultMessage}&lt;/p&gt;
&lt;p style=&quot;color: #6B7280; font-size: 12px;&quot;&gt;Please review the entered details or click Previous to adjust.&lt;/p&gt;
&lt;/div&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
