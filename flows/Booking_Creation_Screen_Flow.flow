            <fieldText>&lt;div style=&quot;display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #E5E7EB; padding-bottom: 8px; margin-bottom: 12px;&quot;&gt;&lt;div style=&quot;font-size: 20px; font-weight: 500; color: #111827;&quot;&gt;New Booking&lt;/div&gt;&lt;div style=&quot;font-size: 12px; color: #EA001E; font-weight: 500;&quot;&gt;* = Required Information&lt;/div&gt;&lt;/div&gt;</fieldText>
